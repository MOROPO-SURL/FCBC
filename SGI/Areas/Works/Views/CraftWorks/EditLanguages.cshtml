@using MOROPO.SAPRESSC.Middleware.Identity.Persistence.Enumerations;

@model MOROPO.FCBC.SGI.Models.View.CraftWorkLanguageManagerViewModel

@{
    ViewData["Title"] = "Editar Obra de Artes Aplicadas (Idiomas)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Obras de Artes Visuales",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<div class="card" style="margin-bottom: 20px;">
    <div class="card-header">
        <h4>@ViewData["Title"]</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" asp-action="edit" asp-route-key="@Model.Work.Id">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="editauthors" asp-route-key="@Model.Work.Id">Autores</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="editelaboration" asp-route-key="@Model.Work.Id">Elaboración</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="editimages" asp-route-key="@Model.Work.Id">Imágenes</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="editattachments" asp-route-key="@Model.Work.Id">Archivos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="ArtWorkAwards" asp-route-key="@Model.Work.Id">Trayectoria</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditThematic" asp-route-key="@Model.Work.Id">Temáticas</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditVideos" asp-route-key="@Model.Work.Id">Videos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Idiomas</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        @await Html.PartialAsync("_ContextDetailPartial.cshtml", Model.Work)
        <div class="modal fade" id="add-attachment" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="add-attachment-title">Agregar Idioma</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    @using (Html.BeginForm("AddLanguage", "CraftWorks", new { key = Model.Work.Id }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
                    {
                        var craftWorkLanguagesInputViewModel = new MOROPO.FCBC.SGI.Models.View.WorkLanguagesInputViewModel();
                        craftWorkLanguagesInputViewModel.NotSelectedLanguages = Model.NotSelectedLanguage;
                        craftWorkLanguagesInputViewModel.WorkId = Model.Work.Id;

                        @await Html.PartialAsync("../../../../Views/Shared/Partials/_AddLanguageModalBodyPartial", craftWorkLanguagesInputViewModel)
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Agregar</button>
                            <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        @if (Model.Translations.Count() <= 0)
        {
            <p class="text-muted mb-0">Sin elementos que mostrar</p>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model.Translations)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="modal fade" id="delete-attachment-@item.CraftWork.Id-@item.TranslatableLanguage.ToString()" tabindex="-1" role="dialog" aria-labelledby="delete-attachment-@item.CraftWork.Id-lable" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    @using (Html.BeginForm("DeleteLanguage", "CraftWorks", new { key = Model.Work.Id }, FormMethod.Post, true, new { @class = "modal-content" }))
                                    {

                                        @Html.Hidden("CraftWorkId", Model.Work.Id)
                                        @Html.Hidden("translatableLanguage", item.TranslatableLanguage)

                                        <div class="modal-header">
                                            <h4 class="modal-title" id="delete-attachment-@item.CraftWork.Id-lable">Eliminar Idioma</h4>
                                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                        </div>
                                        <div class="modal-body">
                                            <p>Esta seguro que desea eliminar el idioma @item.TranslatableLanguage?</p>
                                        </div>
                                        <div class="modal-footer" style="margin-top: 0;">
                                            <button type="submit" class="btn btn-danger">Eliminar</button>
                                            <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-2">

                            <h4>@item.CraftWorkLanguege.Name</h4>

                            <p style="color: #6c757d; word-wrap: break-word;">@item.CraftWorkLanguege.TranslatableLanguage.ToString()</p>
                            <div class="mt-3">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-danger" href="#" data-toggle="modal" data-target="#delete-attachment-@item.CraftWork.Id-@item.TranslatableLanguage.ToString()">Eliminar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <div class="card-footer">
        <a class="btn btn-primary" href="#" data-toggle="modal" data-target="#add-attachment">Agregar</a>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
</div>




