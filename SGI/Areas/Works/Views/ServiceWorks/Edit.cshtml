@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View;

@model MOROPO.FCBC.SGI.Models.View.ServiceWorkInputViewModel

@{
    ViewData["Title"] = "Modificar Obra Artística";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Servicios",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("edit", "serviceworks", new { Area = "works", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>@ViewData["Title"]</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editauthors" asp-route-key="@Model.Id">Autores</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editelaboration" asp-route-key="@Model.Id">Elaboración</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editimages" asp-route-key="@Model.Id">Imágenes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editwinings" asp-route-key="@Model.Id">Menciones</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editattachments" asp-route-key="@Model.Id">Archivos</a>
                </li>
            </ul>
        </div>

        <div class="card-body">
            <div style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.Title, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Title, null, new { @class = "text-danger" })
            </div>
            <div class="row">
                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.LineId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.LineId, Model.AvailableLines, new { @class = "form-control"})
                    @Html.ValidationMessageFor(model => model.LineId, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">
                <fieldset class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Price, new { @class = "control-label" })
                    <div class="input-group">
                        @Html.TextBoxFor(model => model.Price, new { @class = "form-control" })
                        @Html.DropDownListFor(model => model.PriceCurrencyId, Model.AvailableCurrencies, new { @class = "form-control"})
                    </div>
                    @Html.ValidationMessageFor(model => model.Price, null, new { @class = "text-danger" })
                    @Html.ValidationMessageFor(model => model.PriceCurrencyId, null, new { @class = "text-danger" })
                </fieldset>
                <fieldset class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Cost, new { @class = "control-label" })
                    <div class="input-group">
                        @Html.TextBoxFor(model => model.Cost, new { @class = "form-control" })
                        @Html.DropDownListFor(model => model.CostCurrencyId, Model.AvailableCurrencies, new { @class = "form-control"})
                    </div>
                    @Html.ValidationMessageFor(model => model.Cost, null, new { @class = "text-danger" })
                    @Html.ValidationMessageFor(model => model.CostCurrencyId, null, new { @class = "text-danger" })
                </fieldset>
            </div>
            <div style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.About, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.About, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.About, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-ligth" href="@Url.Action("index")">Cancelar</a>
        </div>
    </div>
}