@model MOROPO.FCBC.SGI.Models.View.ValorationDisplayViewModel

<div class="modal fade" id="delete-criterion-@Model.Id" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Eliminar Valoración</h5>
            </div>
            @using (Html.BeginForm("DeleteWorkCriterion", "ArtWorks", null, FormMethod.Post, true, null))
            {
                @Html.HiddenFor(model => model.Critic.Id)
                @Html.HiddenFor(model => model.Id)

                <div class="modal-body">
                    <p class="mb-0">Está seguro que desea eliminar la valoración hecha por <strong> @Model.Critic.Name</strong>?</p>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>

    </div>
</div>

