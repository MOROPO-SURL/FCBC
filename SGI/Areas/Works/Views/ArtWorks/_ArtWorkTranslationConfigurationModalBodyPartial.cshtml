@model MOROPO.FCBC.SGI.Models.View.WorkLanguagesInputViewModel

<div class="modal-body">
    @Html.HiddenFor(model => model.WorkId)

    <div class="mb-3">
        @Html.LabelFor(model => model.TranslatableLanguage, new { @class = "control-label" })
        @Html.TextBoxFor(model => model.TranslatableLanguage, new { @class = "form-control", @readonly = "readonly"})
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.Title, new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Title, new { @class = "form-control"})
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            @Html.LabelFor(model => model.Collection, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Collection, new { @class = "form-control"})
        </div>
        <div class="col-md-6 mb-3">
            @Html.LabelFor(model => model.Location, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Location, new { @class = "form-control"})
        </div>
    </div>
    <div>
        @Html.LabelFor(model => model.About, new { @class = "control-label" })
        @Html.TextAreaFor(model => model.About, 8, 0, new { @class = "form-control"})
    </div>
</div>
