@model MOROPO.FCBC.SGI.Models.View.ArtWorkDisplayViewModel

<div class="alert alert-dark">
    <details>
        <summary class="h4 mb-0">@Model.Title</summary>
        <hr />
        <div class="row no-gutters">

            <div class="col-lg-10 col-md-8 col-sm-6">
                <div class="card-block pl-3">
                    <div class="row">
                        <dl class="col-md-6">
                            <dt>Manifestación Artística</dt>
                            <dd>@Model.Manifestation.Name</dd>
                        </dl>
                        <dl class="col-md-6">
                            <dt>Año de Creación</dt>
                            <dd>@Model.BornYear</dd>

                        </dl>
                    </div>
                    <div class="row">
                        <dl class="col-md-6">
                            <dt>Colección</dt>
                            <dd>@Model.Collection</dd>
                        </dl>
                        <dl class="col-md-6">
                            <dt>Localización</dt>
                            <dd>@Model.Location</dd>
                        </dl>
                        <dl class="col-md-6 mb-0">
                            <dt>Precio</dt>
                            <dd>@Model.PriceSymbol@Model.Price</dd>
                        </dl>
                        <dl class="col-md-6 mb-0">
                            <dt>Costo</dt>
                            <dd>@Model.CostSymbol@Model.Cost</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </details>
</div>