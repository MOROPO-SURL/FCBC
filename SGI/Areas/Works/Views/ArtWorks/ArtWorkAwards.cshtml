@using MOROPO.FCBC.SGI.Models.View
@model MOROPO.FCBC.SGI.Models.View.ArtWorkAwardManageViewModel

@{
    ViewData["Title"] = "Editar Obra de Artes Plásticas (Premios)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Obras de Artes Plásticas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }

        .social-icon {
            font-size: 18px;
            top: 2px;
            margin-left: 8px;
            margin-right: 8px;
        }
    </style>
}

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>Editar Obra de Artes Plásticas</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" asp-action="edit" asp-route-key="@Model.ArtWorkDisplay.Id">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editauthors" asp-route-key="@Model.ArtWorkDisplay.Id">Autores</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editelaboration" asp-route-key="@Model.ArtWorkDisplay.Id">Elaboración</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editimages" asp-route-key="@Model.ArtWorkDisplay.Id">Imágenes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editattachments" asp-route-key="@Model.ArtWorkDisplay.Id">Archivos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active">Premios</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EditThematic" asp-route-key="@Model.ArtWorkDisplay.Id">Temáticas</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="alert alert-dark">
                <details>
                    <summary class="h4 mb-0">@Model.ArtWorkDisplay.Title</summary>
                    <hr />
                    <div class="row no-gutters">

                        <div class="col-lg-10 col-md-8 col-sm-6">
                            <div class="card-block pl-3">
                                <div class="row">
                                    <dl class="col-md-6">
                                        <dt>Manifestación Artística</dt>
                                        <dd>@Model.ArtWorkDisplay.Manifestation.Name</dd>
                                    </dl>
                                    <dl class="col-md-6">
                                        <dt>Año de Creación</dt>
                                        <dd>@Model.ArtWorkDisplay.BornYear</dd>

                                    </dl>
                                </div>
                                <div class="row">
                                    <dl class="col-md-6">
                                        <dt>Colección</dt>
                                        <dd>@Model.ArtWorkDisplay.Collection</dd>
                                    </dl>
                                    <dl class="col-md-6">
                                        <dt>Localización</dt>
                                        <dd>@Model.ArtWorkDisplay.Location</dd>
                                    </dl>
                                    <dl class="col-md-6 mb-0">
                                        <dt>Precio</dt>
                                        <dd>@Model.ArtWorkDisplay.PriceSymbol@Model.ArtWorkDisplay.Price</dd>
                                    </dl>
                                    <dl class="col-md-6 mb-0">
                                        <dt>Costo</dt>
                                        <dd>@Model.ArtWorkDisplay.CostSymbol@Model.ArtWorkDisplay.Cost</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>
                </details>
            </div>
            <div class="page-header">
                <h4>Trayectoría<a class="btn btn-primary btn-sm float-right" href="#" data-toggle="modal" data-target="#add-award-@Model.ArtWorkDisplay.Id"><span class="mdi mdi-plus"></span> Agregar</a></h4>
            </div>


            @await Html.PartialAsync("AddArtWorkAwards", Model)

            <table class="table" style="margin: 0;">
                <thead>
                    <tr>
                        <th>@GlobalViewLocalizationHelper.Localize("Nombre")</th>
                        <th>@GlobalViewLocalizationHelper.Localize("País")</th>
                        <th>@GlobalViewLocalizationHelper.Localize("Año")</th>
                        <th style="width: 1px; white-space: nowrap;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ArtWorkDisplay.Awards.Count > 0)
                    {
                        @foreach (var item in Model.ArtWorkDisplay.Awards)
                        {
                            <tr>
                                <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("String")">@item.Award.Name</td>
                                <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Label")">@item.Award.Country.Name</td>
                                <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Label")">@item.Year</td>
                                <td style="vertical-align: middle;">
                                    <a role="button" href="#" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-@item.Id">Eliminar</a>
                                    @await Html.PartialAsync("DeleteArtWorkAwards", new ArtWorkAwardDisplayViewModel { Id = item.Id, AwardName = item.Award.Name, Context = item.Context, ArtWorkId = Model.ArtWorkDisplay.Id})
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>



