@using MOROPO.FCBC.SGI.Models.View
@model MOROPO.FCBC.SGI.Models.View.ArtWorkCriterionManageViewModel

@{
    ViewData["Title"] = "Editar Obra de Artes (Valoraciones)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Obras",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link href="~/lib/gijgo/combined/css/gijgo.css" rel="stylesheet" type="text/css" />
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }

        .social-icon {
            font-size: 18px;
            top: 2px;
            margin-left: 8px;
            margin-right: 8px;
        }
    </style>
}

    @section scripts {
    <script src="~/lib/gijgo/combined/js/gijgo.js" type="text/javascript"></script>
    <script type="text/javascript">
        $('#DateOfCriterion').datepicker({
            uiLibrary: 'bootstrap4',
            modal: true,
            header: true,
            footer: true,
            format: 'dd/mm/yyyy',
            value: '@Model.DateOfCriterion.ToShortDateString()'
        });
    </script>
}

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>Editar Obra de Artes Plásticas</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" asp-action="edit" asp-route-key="@Model.WorkDisplay.Id">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editauthors" asp-route-key="@Model.WorkDisplay.Id">Autores</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editelaboration" asp-route-key="@Model.WorkDisplay.Id">Elaboración</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editimages" asp-route-key="@Model.WorkDisplay.Id">Imágenes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editattachments" asp-route-key="@Model.WorkDisplay.Id">Archivos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active">Trayectoria</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EditThematic" asp-route-key="@Model.WorkDisplay.Id">Temáticas</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            @await Html.PartialAsync("_ContextDetailPartial.cshtml", Model.WorkDisplay)
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs">
                        <li class="nav-item">
                            <a class="nav-link" asp-action="ArtWorkAwards" asp-route-key="@Model.WorkDisplay.Id">Premios</a>
                        </li>                        
                        <li class="nav-item">
                            <a class="nav-link active">Valoraciones</a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div style="margin-bottom: 20px;">
                        <div class="page-header">
                            <h4>Criterios<a class="btn btn-primary btn-sm float-right" href="#" data-toggle="modal" data-target="#add-criterion-@Model.WorkDisplay.Id"><span class="mdi mdi-plus"></span> Agregar</a></h4>
                        </div>

                        @await Html.PartialAsync("AddCriterionPartial", Model)

                        <table class="table" style="margin: 0;">
                            <thead>
                                <tr>
                                    <th>@GlobalViewLocalizationHelper.Localize("Day of Criterion")</th>
                                    <th>@GlobalViewLocalizationHelper.Localize("Critic")</th>
                                    <th>@GlobalViewLocalizationHelper.Localize("Criterion")</th>
                                    <th style="width: 1px; white-space: nowrap;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.WorkDisplay.ArtWorkAssessmentBridges.Count > 0)
                            {
                                @foreach (var item in Model.WorkDisplay.ArtWorkAssessmentBridges)
                                {
                                    <tr>
                                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("String")">@item.DateOfAssessment</td>
                                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Label")">@item.Critic.Identity.Name @item.Critic.Identity.LastName</td>
                                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Label")">@item.Criterion</td>
                                        <td style="vertical-align: middle;">
                                            <a role="button" href="#" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-criterion-@item.WorkId@item.CriticId">Eliminar</a>
                                            @await Html.PartialAsync("DeleteCriterionPartial", new WorkCriterionDisplayViewModel { WorkId = item.WorkId, CriticId = item.CriticId, WorkName = item.Work.Title, CriticName =  item.Critic.Identity.Name+" "+item.Critic.Identity.LastName, Criterion = item.Criterion})
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
</div>





