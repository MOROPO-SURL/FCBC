@model MOROPO.FCBC.SGI.Models.View.ArtWorkDisplayViewModel

<!-- Modal -->
<div class="modal fade " id="descrip-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Detalles</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <h5>@Html.DisplayNameFor(model => model.Title)</h5>
                            <p>@Model.Title</p>
                        </div>
                        <div class="col-md-4">
                            <h5>@Html.DisplayNameFor(model => model.BornYear)</h5>
                            <p>@Model.BornYear</p>
                        </div> 
                        <div class="col-md-4">
                            <h5>@Html.DisplayNameFor(model => model.Location)</h5>
                            <p>@Model.Location</p>
                        </div>                        
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-6">
                            <h5>@Html.DisplayNameFor(model => model.Price)</h5>
                            @{
                                var spacePrice = "";
                                if(Model.PriceCurrency.IsSpacedSymbol){
                                    spacePrice = " ";
                                }
                                @if (Model.PriceCurrency.Position == MOROPO.FCBC.SGI.Persistence.Enumerations.CurrencySymbolPosition.Prefix)
                                {
                                    <p>@Model.PriceSymbol@spacePrice@Model.Price</p>
                                }else{
                                    <p>@Model.Price@spacePrice@Model.PriceSymbol</p>
                                }
                            }
                        </div>
                        <div class="col-md-6">
                            <h5>@Html.DisplayNameFor(model => model.Cost)</h5>
                            @{
                                var space = "";
                                if (Model.CostCurrency.IsSpacedSymbol)
                                {
                                    space = " ";
                                }
                                @if (Model.CostCurrency.Position == MOROPO.FCBC.SGI.Persistence.Enumerations.CurrencySymbolPosition.Prefix)
                                {
                                    <p>@Model.CostSymbol@space@Model.Cost</p>
                                }
                                else
                                {
                                    <p>@Model.Cost@space@Model.CostSymbol</p>
                                }
                            }
                        </div>
                    </div>
                    <hr/>
                    <div class="row">
                        <div class="col-md-12">
                            <h5>@Html.DisplayNameFor(model => model.Manifestation)</h5>
                            <p>@Model.Manifestation.Name</p>
                        </div>
                    </div>
                    <hr />
                    <h5>@Html.DisplayNameFor(model => model.About)</h5>
                    <p style="word-wrap: break-word;">@Model.About</p>
                    <div class="row">
                        <div class="col-md-4">
                            
                        </div>                        
                    </div>
                    
                   
                </div>
            </div>
            
        </div>
    </div>
</div>

