@model MOROPO.FCBC.SGI.Models.View.ArtistContactsManageViewModel

@{
    ViewData["Title"] = "Editar Artista";

    

    Layout = "_Layout";
}

@section styles {
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }
    </style>
}

    <div class="card" style="margin-bottom: 20px;">
        
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 col-sm-" style="margin-bottom: 20px;">
                    <div class="card">
                    @if (Model.Artist.ImageId != System.Guid.Empty)
                    {
                        <img class="img-thumbnail" src="~/media/images/@Model.Artist.ImageId.@Model.Artist.ImageExtension" />
                    }
                    else
                    {
                        <img class="img-thumbnail" src="~/media/images/default-person.png" />
                    }

                    <div class="col-md-9 col-sm-9">
                        <dl style="margin-bottom: 0;">
                            <dt class="text-secondary">@GlobalViewLocalizationHelper.Localize("Name", ViewLocalizer)</dt>
                            <dd>@Model.Artist.Name</dd>
                            <dt class="text-secondary">@GlobalViewLocalizationHelper.Localize("LastName", ViewLocalizer)</dt>
                            <dd>@Model.Artist.LastName</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <h5>@Html.DisplayNameFor(model => model.Artist.State)</h5>
                    <p>@Html.DisplayName(Model.Artist.State.Name)</p>
                </div>
                <div class="col-md-6">
                    <h5>@Html.DisplayNameFor(model => model.Artist.Municipality)</h5>
                    <p>@Html.DisplayName(Model.Artist.Municipality.Name)</p>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <h5>@Html.DisplayNameFor(model => model.Artist.Sex)</h5>
                    <p>@Model.Artist.Sex</p>
                </div>
                <div class="col-md-6">
                    <h5>@Html.DisplayNameFor(model => model.Artist.CivilStatus)</h5>
                    <p>@Model.Artist.CivilStatus</p>
                </div>
            </div>
            <hr />
            <h5>@Html.DisplayNameFor(model => model.Artist.About)</h5>
            <p>@Model.Artist.About</p>
            <div class="row">
                <div class="col-md-4">
                    <h5>@Html.DisplayNameFor(model => model.Artist.AdmitionMode)</h5>
                    <p>@Html.DisplayName(Model.Artist.AdmitionMode.ToString())</p>
                </div>
                <div class="col-md-8">
                    <h5>Asociación | Resolución</h5>
                    @if (Model.Artist.AdmitionModeContext != null)
                    {
                        @if (Model.Artist.AdmitionModeContext.Contains("Resolution|"))
                        {
                            <p>@Model.Artist.Resolution.NumberResolution-@Model.Artist.Resolution.Title</p>
                        }
                        else if (Model.Artist.AdmitionModeContext.Contains("Association|"))
                        {
                            <p>@Model.Artist.Association.OrganizationIdentityName</p>
                        }
                    }

                </div>
            </div>
            <div class="row">
                <div>
                    <h5>@Html.DisplayNameFor(model => model.Artist.AddressPostal)</h5>
                    <p>@Html.DisplayName(Model.Artist.AddressPostal)</p>
                </div>
            </div>
            <h5>Lista de Manifestaciones</h5>
            @foreach (var item in Model.Artist.ArtistManifestationBridges)
            {
                <h5>Manifestación</h5>
                <p>@item.Manifestation.Name</p>
                <hr />
            }
            
        </div>
        
    </div>
    
</div>


