@model MOROPO.FCBC.SGI.Models.View.ArtistServiceLinesInputViewModel

@{
    ViewData["Title"] = "Modificar Creador (Manifestaciones de Servicios)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Creador",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("editservicelines", "artists", new { key = Model.Artist.Id }, FormMethod.Post, true, null))
{       
    var selectableIndex = 0;
                
    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>Modificar Creador</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" asp-action="edit" asp-route-key="@Model.Artist.Id">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="contacts" asp-route-key="@Model.Artist.Id">Contactos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="#">Manifestaciones</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="ArtistAwards" asp-route-key="@Model.Artist.Id">Trayectoria</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editattachments" asp-route-key="@Model.Artist.Id">Archivos</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            @await Html.PartialAsync("_ContextDetailPartial.cshtml", Model.Artist)
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs">
                        <li class="nav-item">
                            <a class="nav-link" asp-action="editartisticmanifestations" asp-route-key="@Model.Artist.Id">Artes Visuales</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="editcraftmanifestations" asp-route-key="@Model.Artist.Id">Artes Aplicadas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="#">Servicios</a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var item in Model.Manifestations)
                        {
                            <div class="col-md-4">
                                @Html.EditorFor(model => item, "SelectionDescriptedGuidIDItemInputViewModel", string.Format("Manifestations[{0}]", selectableIndex++))
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}


