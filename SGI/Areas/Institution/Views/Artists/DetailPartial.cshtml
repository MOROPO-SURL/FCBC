@model MOROPO.FCBC.SGI.Models.View.ArtistDisplayViewModel

<!-- Modal -->
<div class="modal fade" id="descrip-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Detalles</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-body">                                       
                        <h5>@Html.DisplayNameFor(model => model.Name)</h5>
                        <p>@Model.Name</p>
                        <hr />
                        <h5>@Html.DisplayNameFor(model => model.LastName)</h5>
                        <p>@Model.LastName</p>
                        <hr />
                        <h5>@Html.DisplayNameFor(model => model.Sex)</h5>
                        <p>@Model.Sex</p>
                        <hr />
                        <h5>@Html.DisplayNameFor(model => model.CivilStatus)</h5>
                        <p>@Model.CivilStatus</p>
                    
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
