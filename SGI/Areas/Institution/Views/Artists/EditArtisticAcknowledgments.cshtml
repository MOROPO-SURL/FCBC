@model MOROPO.FCBC.SGI.Models.View.ArtistInputViewModel

@{
    ViewData["Title"] = "Editar Creador (Manifestaciones Artísticas)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Creador",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = "Modificar Creador",
            Url = Url.Action("edit", "artists", new { key = Model.Id })
        },
        new BreadcrumbViewModel
        {
            Caption = "Premios"
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("editartisticacknowledgments", "artists", new { key = Model.Id }, FormMethod.Post, true, null))
{
    var selectableAwardsIndex = 0;
    var selectableRecognitionIndex = 0;
    var selectableDisctintionIndex = 0;

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>Editar Creador</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" asp-action="edit" asp-route-key="@Model.Id">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="contacts" asp-route-key="@Model.Id">Contactos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EditArtisticManifestations">Manifestaciones</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="#">Reconocimientos</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-toggle="tab" href="#awards" role="tab" aria-controls="awards" aria-selected="true">Premios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="tab" href="#recognitions" role="tab" aria-controls="recognitions" aria-selected="false">Reconocimientos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="tab" href="#distintions" role="tab" aria-controls="distintions" aria-selected="false">Distinciones</a>
                        </li>                        
                    </ul>
                </div>
                <div class="card-body tab-content">
                    <div class="row tab-pane fade show active" id="awards" role="tabpanel" aria-labelledby="awards-tab">
                        @if (Model.AwardsToSelect != null || Model.AwardsToSelect.Count() > 0) { 
                            @foreach (var item in Model.AwardsToSelect)
                            {
                                <div class="col-md-4">
                                    @Html.EditorFor(model => item, "SelectionDescriptedGuidIDItemInputViewModel", string.Format("AwardsToSelect[{0}]", selectableAwardsIndex++))
                                </div>
                            }
                        }
                    </div>
                    <div class="row tab-pane fade" id="recognitions" role="tabpanel" ariaa-labelledby="recognitions-tab">
                        @if (Model.RecognitionsToSelect != null || Model.RecognitionsToSelect.Count() > 0)
                        {
                            @foreach (var item in Model.RecognitionsToSelect)
                            {
                                <div class="col-md-4">
                                    @Html.EditorFor(model => item, "SelectionDescriptedGuidIDItemInputViewModel", string.Format("RecognitionsToSelect[{0}]", selectableRecognitionIndex++))
                                </div>
                            }
                        }
                    </div>
                    <div class="row tab-pane fade" id="distintions" role="tabpanel" ariaa-labelledby="distintions-tab">
                        @if (Model.DistintionsToSelect != null || Model.DistintionsToSelect.Count() > 0)
                        {
                            @foreach (var item in Model.DistintionsToSelect)
                            {
                                <div class="col-md-4">
                                    @Html.EditorFor(model => item, "SelectionDescriptedGuidIDItemInputViewModel", string.Format("DistintionsToSelect[{0}]", selectableDisctintionIndex++))
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}


