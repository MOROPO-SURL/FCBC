@model MOROPO.FCBC.SGI.Models.View.ArtistAssessmentBridgeDisplayViewModel


<div class="modal fade" id="update-criterion-@Model.ArtistId@Model.CriticId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="add-emailcontact-title">Agregar Valoraciones</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Html.BeginForm("UpdateArtistCriterion", "artists", null, FormMethod.Post, true, null))
            {
                <div class="modal-body">
                    @Html.HiddenFor(model => model.ArtistId)
                    @Html.HiddenFor(model => model.CriticId)

                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.DateOfAssessment, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.DateOfAssessment,"{0:dd/MM/yyyy}" , new {  @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.DateOfAssessment, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.CriticId, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.CriticId, Model.SelectCritics, new { @class = "form-control"})
                            @Html.ValidationMessageFor(model => model.CriticId, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.Criterion, new { @class = "control-label" })
                            @Html.TextAreaFor(model => model.Criterion, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Criterion, null, new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Modificar</button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>

