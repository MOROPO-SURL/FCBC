@model MOROPO.FCBC.SGI.Models.View.EmployeeAdministrativeRolesInputViewModel

@{
    ViewData["Title"] = "Modificar Trabajador";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Trabajador",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<div class="card mb-3">
    <div class="card-header"><h4>@ViewData["Title"]</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("edit", @Model.Employee.Id)">Información</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("contacts", @Model.Employee.Id)">Contactos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Roles Administrativos</a>
            </li>
        </ul>
    </div>
        
    @using (Html.BeginForm("addadministrativeroles", "employees", new { key = Model.Employee.Id }, FormMethod.Post, true, null))
    {
        @Html.HiddenFor(model => model.Employee.Id)
        <div class="card-body pb-1">
            @await Html.PartialAsync("_ContextDetailPartial.cshtml", Model.Employee)

            <div class="row">
                @if (Model.SelectableRoles != null && Model.SelectableRoles.Count() > 0)
                {
                    for (int i = 0; i < Model.SelectableRoles.Count(); i++)
                    {
                        <div class="col-md-4">
                            @Html.EditorFor(subModel => subModel.SelectableRoles[i], "SelectionDescriptedGuidIDItemInputViewModel")
                        </div>
                    }
                }
                else
                {
                    <div class="col-md-12 text-muted mb-3">Sin elementos que mostrar.</div>
                }
            </div>
        </div>   
    <div class="card-footer">
        <button type="submit" class="btn btn-primary">Modificar</button>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
}
</div>


