@model MOROPO.FCBC.SGI.Models.View.EmployeeContactsManageViewModel

@{
    ViewData["Title"] = "Editar Trabajador";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Trabajador",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }
    </style>
}

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header"><h4>@ViewData["Title"]</h4></div>
        <div style="margin-bottom: 20px;"></div>

        <ul class="nav nav-tabs justify-content-center" style="margin-bottom: 20px;">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("edit", @Model.Employee.Id)">Información</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Contactos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("edit", @Model.Employee.Id)">Roles Administrativos</a>
            </li>
        </ul>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-" style="margin-bottom: 20px;">
                    <div class="card">
                        @if (Model.Employee.ImageId != System.Guid.Empty)
                        {
                            <img class="img-thumbnail" src="~/media/images/@Model.Employee.ImageId.@Model.Employee.ImageExtension" />
                        }
                        else
                        {
                            <img class="img-thumbnail" src="~/media/images/default-person.png" />
                        }

                        <div class="col-lg-10 col-md-9 col-sm-9">
                            <dl style="margin-bottom: 0;">
                                <dt class="text-secondary">@GlobalViewLocalizationHelper.Localize("Name", ViewLocalizer)</dt>
                                <dd>@Model.Employee.Name</dd>
                            <dt class="text-secondary">@GlobalViewLocalizationHelper.Localize("LastName", ViewLocalizer)</dt>
                            <dd>@Model.Employee.LastName</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="margin-bottom: 20px;">
                    <div class="page-header">
                    <h4>Contactos Telefónicos<a class="btn btn-primary btn-sm float-right" href="#" data-toggle="modal" data-target="#add-phonecontact"><span class="mdi mdi-plus"></span> Agregar</a></h4>
                    </div>


                @await Html.PartialAsync("AddPhoneContactPartial", new MOROPO.FCBC.SGI.Models.View.EmployeePhoneContactInputViewModel
                        {
                        EmployeeId = Model.Employee.Id
                        })
                    
                    <table class="table" style="margin: 0;">
                        <thead>
                            <tr>
                                <th>@GlobalViewLocalizationHelper.Localize("Number")</th>
                                <th>@GlobalViewLocalizationHelper.Localize("Label")</th>
                                <th style="width: 1px; white-space: nowrap;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PhoneContacts.Count > 0)
                            {
                                @foreach (var item in Model.PhoneContacts)
                                {
                                    <tr>
                                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Number")">@item.Number</td>
                                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Label")">@item.Label</td>
                                        <td style="vertical-align: middle;">
                                        <a role="button" href="#" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-phonecontact-@item.Id">Eliminar</a>
                                                @await Html.PartialAsync("DeletePhoneContactPartial", item)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6" style="margin-bottom: 20px;">
                    <div class="page-header">
                    <h4>Contactos de Correos Electrónicos<a class="btn btn-primary btn-sm float-right" href="#" data-toggle="modal" data-target="#add-nautacontact"><span class="mdi mdi-plus"></span> Agregar</a></h4>
                    </div>
                @await Html.PartialAsync("AddEmailContactPartial", new MOROPO.FCBC.SGI.Models.View.EmployeeEmailContactInputViewModel
                        {
                        EmployeeId = Model.Employee.Id
                        })
                    <table class="table" style="margin: 0;">
                        <thead>
                            <tr>
                                <th>@GlobalViewLocalizationHelper.Localize("Email")</th>
                                <th>@GlobalViewLocalizationHelper.Localize("Label")</th>
                                <th style="width: 1px; white-space: nowrap;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.EmailContacts.Count > 0)
                            {
                                @foreach (var item in Model.EmailContacts)
                                {
                                    <tr>
                                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Email")">@item.Address</td>
                                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Label")">@item.Label</td>
                                        <td style="vertical-align: middle;">
                                            <a role="button" href="#" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-emailcontact-@item.Id">Eliminar</a>
                                                @await Html.PartialAsync("DeleteEmailContactPartial", item)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
        </div>
    <div class="card-footer">
        <a class="btn btn-default" href="@Url.Action("index")">Regresar al listado</a>
    </div>
    </div>
     

