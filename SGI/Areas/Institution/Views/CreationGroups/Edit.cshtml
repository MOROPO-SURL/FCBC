@using SmartSolucionesCuba.SAPRESSC.Middleware.Identity.Persistence.Enumerations;

@model MOROPO.FCBC.SGI.Models.View.CreationGroupInputViewModel

@{
    ViewData["Title"] = "Editar Grupos de Creación";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Grupos de Creación",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link rel="stylesheet" href="~/lib/twitter-bootstrap/css/bootstrap-multiselect.css.css" />
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }
    </style>
}

    @section scripts {
    <script src="~/js/Views/CreationGroups/Edit.js"></script>
    <script type="text/javascript">
        $('#BornDate').datepicker({
            uiLibrary: 'bootstrap4',
            modal: true,
            header: true,
            footer: true,
            format: 'dd/mm/yyyy',
            value: '@Model.CreateDate.ToShortDateString()'
        });

        $('#RegistrationEndAt').datepicker({
            uiLibrary: 'bootstrap4',
            modal: true,
            header: true,
            footer: true,
            format: 'dd/mm/yyyy',
            value: '@Model.RegistrationEndAt.ToShortDateString()'
        });

        $(document).ready(function () {
            var admitionModel = $('#AdmitionModel').val();
            if (admitionModel == "Resolution") {
                $("#show-hide-association").addClass("d-none");
                $("#show-hide-resolution").removeClass("d-none");
            }
        });

        $(function () {
            $(document).on("change", "#ImageFile", function () {
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function () {
                        $('#ImageFilePreview').attr('src', this.result);
                    }
                }

            });
        });
    </script>
    <script type="text/javascript">
        $(function () {
            $('.listbox').multiselect({
                includeSelectAllOption: true,
                templates: {
                    li: '<li><a href="javascript:void(0);"><label class="pl-2"></label></a></li>'
                }

            });
        });
    </script>
    }

@using (Html.BeginForm("edit", "creationgroups", new { Area = "institution", key = string.Empty }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(model => model.Id)

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>@ViewData["Title"]</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Información</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editartisticmanifestations" asp-route-key="@Model.Id">Manifestaciones</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("members", @Model.Id)">Miembros</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("contacts", @Model.Id)">Contactos</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-4" style="margin-bottom: 20px;">
                    <div class="card">
                        @if (Model.ImageId != System.Guid.Empty)
                        {
                            <img src="~/media/images/@Model.ImageId.@Model.ImageExtension" class="card-img-top" id="ImageFilePreview" />
                        }
                        else
                        {
                            <img src="~/img/default-person-picture.jpg" class="card-img-top" id="ImageFilePreview" />
                        }

                        <label class="btn btn-light" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-bottom: 0;">
                            @GlobalViewLocalizationHelper.Localize("Upload", ViewLocalizer) ...
                            @Html.EditorFor(model => model.ImageFile)
                        </label>
                    </div>
                    @Html.ValidationMessageFor(model => model.ImageFile, null, new { @class = "text-danger" })
                </div>
                <div class="col-lg-9 col-sm-8">
                    <div class="row">
                        <div class="col-sm-6" style="margin-bottom: 20px;">
                            <div style="margin-bottom: 20px;">
                                @Html.LabelFor(model => model.OrganizationIdentityName, new { @class = "control-label" })
                                @Html.TextBoxFor(model => model.OrganizationIdentityName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.OrganizationIdentityName, null, new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-lg-5 col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.CreateDate, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.CreateDate, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.CreateDate, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-5 col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.RegistrationNumber, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.RegistrationNumber, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.RegistrationNumber, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-5 col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.RegistrationEndAt, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.RegistrationEndAt, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.RegistrationEndAt, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-5 col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.AdmitionModel, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.AdmitionModel, new SelectListItem[] { new SelectListItem(GlobalViewLocalizationHelper.Localize("Resolución", ViewLocalizer), AdmitionMode.Resolution.ToString()) },"", new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.AdmitionModel, null, new { @class = "text-danger" })
                        </div>
                        <div id="show-hide-resolution" class="col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.ResolutionId, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.ResolutionId, Model.Resolutions, "", new { @class = "form-control"})
                            @Html.ValidationMessageFor(model => model.ResolutionId, null, new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-default" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}