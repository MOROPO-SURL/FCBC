@using MOROPO.FCBC.SGI.Models.View
@model MOROPO.FCBC.SGI.Models.View.CreationGroupAwardManageViewModel

@{
    ViewData["Title"] = "Editar Creador";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Grupos",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }

        .social-icon {
            font-size: 18px;
            top: 2px;
            margin-left: 8px;
            margin-right: 8px;
        }
    </style>
}

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>Editar Creador</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("edit", @Model.GroupDisplay.Id)">Generales</a>
                </li>                
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("editartisticmanifestations", @Model.GroupDisplay.Id)">Manifestaciones</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("members", @Model.GroupDisplay.Id)">Miembros</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Contactos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active">Reconocimientos</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs">
                        <li class="nav-item">
                            <a class="nav-link active" href="#">Premios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="EditGroupRecognitions" asp-route-key="@Model.GroupDisplay.Id">Reconocimientos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="EditGroupDistintions" asp-route-key="@Model.GroupDisplay.Id">Distinciones</a>
                        </li>
                    </ul>
                </div>
                <div class="row">
                    <div class="col-lg-3 col-md-4 col-sm-" style="margin-bottom: 20px;">
                        <div class="card">
                        @if (Model.GroupDisplay.ImageId != System.Guid.Empty)
                        {
                            <img class="img-thumbnail" src="~/media/images/@Model.GroupDisplay.ImageId.@Model.GroupDisplay.ImageExtension" />
                        }
                        else
                        {
                            <img class="img-thumbnail" src="~/img/default-person-picture.jpg" />
                        }

                        <div class="col-lg-10 col-md-9 col-sm-9">
                            <dl style="margin-bottom: 0;">
                                <dt class="text-secondary">@GlobalViewLocalizationHelper.Localize("Name", ViewLocalizer)</dt>
                                <dd>@Model.GroupDisplay.OrganizationIdentityName</dd>                                
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6" style="margin-bottom: 20px;">
                <div class="page-header">
                    <h4>Trayectoría<a class="btn btn-primary btn-sm float-right" href="#" data-toggle="modal" data-target="#add-award-@Model.GroupDisplay.Id"><span class="mdi mdi-plus"></span> Agregar</a></h4>
                </div>


                @await Html.PartialAsync("AddAwardsPartial", Model)

                <table class="table" style="margin: 0;">
                    <thead>
                        <tr>
                            <th>@GlobalViewLocalizationHelper.Localize("Nombre")</th>
                            <th>@GlobalViewLocalizationHelper.Localize("País")</th>
                            <th>@GlobalViewLocalizationHelper.Localize("Descripción")</th>
                            <th style="width: 1px; white-space: nowrap;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.GroupDisplay.CreationGroupAwards.Count > 0)
                        {
                            @foreach (var item in Model.GroupDisplay.CreationGroupAwards)
                            {
                                <tr>
                                    <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("String")">@item.Award.Name</td>
                                    <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Label")">@item.Award.Country.Name</td>
                                    <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Label")">@item.Context</td>
                                    <td style="vertical-align: middle;">
                                        <a role="button" href="#" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-award-@item.Id">Eliminar</a>
                                        @await Html.PartialAsync("DeleteAwardPartial", new CreationGroupAwardDisplayViewModel { Id = item.Id, AwardName = item.Award.Name, Context = item.Context, GroupId = Model.GroupDisplay.Id})
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

    </div>
    <div class="card-footer">
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
</div>




