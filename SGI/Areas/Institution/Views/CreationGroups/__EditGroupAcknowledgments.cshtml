@model MOROPO.FCBC.SGI.Models.View.CreationGroupInputViewModel

@{
    ViewData["Title"] = "Editar Grupos de Creación";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Grupos de Creación",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = "Modificar  Grupo de Creación",
            Url = Url.Action("edit", "creationgroup", new { key = Model.Id })
        },
        new BreadcrumbViewModel
        {
            Caption = "Premios"
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("editgroupacknowledgments", "creationgroups", new { key = Model.Id }, FormMethod.Post, true, null))
{
    var selectableIndex = 0;

        <div class="card" style="margin-bottom: 20px;">
            <div class="card-header">
                <h4>Editar Creador</h4>
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <a class="nav-link" asp-action="edit" asp-route-key="@Model.Id">Generales</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-action="contacts" asp-route-key="@Model.Id">Contactos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-action="editartisticmanifestations">Manifestaciones</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Trayectoria</a>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="card">
                    <div class="card-header">
                        <ul class="nav nav-tabs card-header-tabs">
                            <li class="nav-item">
                                <a class="nav-link active" href="#">Premios</a>
                            </li>
                            <li class="nav-item">
                            <a class="nav-link" asp-action="editgrouprecognitions" asp-route-key="@Model.Id">Reconocimientos</a>
                            </li>
                            <li class="nav-item">
                            <a class="nav-link" asp-action="editgroupdistintions" asp-route-key="@Model.Id">Distinciones</a>
                            </li>                        
                        </ul>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">Modificar</button>
                <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
            </div>
        </div>
}


