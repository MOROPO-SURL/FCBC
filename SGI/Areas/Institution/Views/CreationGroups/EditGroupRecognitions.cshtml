@model MOROPO.FCBC.SGI.Models.View.CreationGroupRecognitionManageViewModel

@{
    ViewData["Title"] = "Editar Grupos de Creación (Reconocimientos)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Grupos de Creación",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("editgrouprecognitions", "creationgroups", new { key = Model.Group.Id }, FormMethod.Post, true, null))
{
    var selectableIndex = 0;

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>Editar Grupos de Creación</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("edit", @Model.Group.Id)">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("editartisticmanifestations", @Model.Group.Id)">Manifestaciones</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("members", @Model.Group.Id)">Miembros</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("contacts", @Model.Group.Id)">Contactos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active">Trayectoria</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("editattachments", @Model.Group.Id)">Archivos</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="alert alert-dark">
                <details>
                    <summary class="h4 mb-0">@Model.Group.Name</summary>
                    <hr />
                    <div class="row no-gutters">
                        <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                            @if (Model.Group.ImageId != null)
                            {
                                <img class="img-thumbnail" src="~/media/images/@Model.Group.ImageId.@Model.Group.ImageExtension" />
                            }
                            else
                            {
                                <img class="img-thumbnail" src="~/img/default-person-picture.jpg" />
                            }
                        </div>
                        <div class="col-lg-10 col-md-8 col-sm-6">
                            <div class="card-block pl-3">
                                <div class="row">
                                    <dl class="col-md-6">
                                        <dt>Fecha de Creación</dt>                                        
                                        @if (Model.Group.CreatedAt == null)
                                        {
                                            <dd>-</dd>
                                        }
                                        else 
                                        {
                                            <dd>@Model.Group.CreatedAt.Value.ToShortDateString()</dd>
                                        }
                                    </dl>
                                    <dl class="col-md-6">
                                        <dt>Marca</dt>                                        
                                        @if (Model.Group.Brand == null)
                                        {
                                            <dd>-</dd>
                                        }
                                        else 
                                        {
                                            <dd>@Model.Group.Brand</dd>
                                        }
                                    </dl>
                                </div>
                                <div class="row">
                                    <dl class="col-md-6">
                                        <dt>Número de Registro del Creador</dt>
                                        <dd>@Model.Group.RegistrationNumber</dd>
                                    </dl>
                                    <dl class="col-md-6">
                                        <dt>Fecha de Registro</dt>
                                        <dd>@Model.Group.RegistratedAt.ToShortDateString()</dd>
                                    </dl>
                                    <dl class="col-md-6 mb-0">
                                        <dt>Fecha de Expiración</dt>
                                        <dd>@Model.Group.RegistrationEndAt.ToShortDateString()</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>
                </details>                
            </div>
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs">
                        <li class="nav-item">
                            <a class="nav-link" asp-action="creationgroupawards">Premios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" asp-route-key="@Model.Group.Id">Reconocimientos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="editgroupdistintions" asp-route-key="@Model.Group.Id">Distinciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="EditGroupCriterion" asp-route-key="@Model.Group.Id">Valoraciones</a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="row">
                        @if (Model.RecognitionsToSelect != null || Model.RecognitionsToSelect.Count() > 0)
                        {
                            @foreach (var item in Model.RecognitionsToSelect)
                            {
                                <div class="col-md-4">
                                    @Html.EditorFor(model => item, "SelectionDescriptedGuidIDItemInputViewModel", string.Format("modelInput[{0}]", selectableIndex++))
                                </div>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}



