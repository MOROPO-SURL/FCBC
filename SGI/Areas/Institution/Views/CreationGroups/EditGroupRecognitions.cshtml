@model MOROPO.FCBC.SGI.Models.View.CreationGroupInputViewModel

@{
    ViewData["Title"] = "Editar Grupo de Creación (Reconocimientos)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Grupo de Creación",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = "Modificar Grupo de Creación",
            Url = Url.Action("edit", "creationgroups", new { key = Model.Id })
        },
        new BreadcrumbViewModel
        {
            Caption = "Premios"
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("EditGroupRecognitions", "creationgroups", new { key = Model.Id }, FormMethod.Post, true, null))
{
    var selectableIndex = 0;

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>Editar Creador</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" asp-action="edit" asp-route-key="@Model.Id">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="contacts" asp-route-key="@Model.Id">Contactos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EditArtisticManifestations">Manifestaciones</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="#">Reconocimientos</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs">
                        <li class="nav-item">
                            <a class="nav-link" asp-action="CreationGroupAwards">Premios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" asp-route-key="@Model.Id">Reconocimientos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="EditGroupDistintions" asp-route-key="@Model.Id">Distinciones</a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="row">
                        @if (Model.RecognitionsToSelect != null || Model.RecognitionsToSelect.Count() > 0)
                        {
                            @foreach (var item in Model.RecognitionsToSelect)
                            {
                                <div class="col-md-4">
                                    @Html.EditorFor(model => item, "SelectionDescriptedGuidIDItemInputViewModel", string.Format("RecognitionsToSelect[{0}]", selectableIndex++))
                                </div>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}



