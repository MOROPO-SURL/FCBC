@model MOROPO.FCBC.SGI.Models.View.GroupAssessmentBridgeDisplayViewModel


<div class="modal fade" id="update-criterion-@Model.GroupId@Model.CriticId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="add-emailcontact-title">Agregar Valoraciones</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @{
                var critis = new List<SelectListItem>();
                var asign = @Model.AsignIdUtility(Model.CriticId);
                foreach (var cri in Model.SelectCritics)
                {
                    critis.Add(new SelectListItem { Value = cri.Value, Text = cri.Text, Selected = cri.Value == Model.CriticId.ToString() });
                }
            }

            @using (Html.BeginForm("UpdateGroupCriterion", "CreationGroups", null, FormMethod.Post, true, null))
            {
                <div class="modal-body">
                    @Html.HiddenFor(model => model.GroupId)
                    @Html.HiddenFor(model => model.CriticId)

                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.DateOfAssessment, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.DateOfAssessment,"{0:dd/MM/yyyy}" , new {  @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.DateOfAssessment, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.CriticUpdateId, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.CriticUpdateId, critis, new { @class = "form-control"})
                            @Html.ValidationMessageFor(model => model.CriticUpdateId, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.Criterion, new { @class = "control-label" })
                            @Html.TextAreaFor(model => model.Criterion, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Criterion, null, new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Modificar</button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>


