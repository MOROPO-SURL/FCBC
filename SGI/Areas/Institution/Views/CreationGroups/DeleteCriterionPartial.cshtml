@model MOROPO.FCBC.SGI.Models.View.GroupCriterionDisplayViewModel

<div class="modal fade" id="delete-criterion-@Model.GroupId@Model.CriticId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Eliminar Valoración</h5>
            </div>
            @using (Html.BeginForm("DeleteGroupCriterion", "CreationGroups", null, FormMethod.Post, true, null))
            {
                @Html.HiddenFor(model => model.CriticId)
                @Html.HiddenFor(model => model.GroupId)



                <div class="modal-body">
                    <p>Está seguro que desea eliminar la valoración hecha por <strong> @Model.CriticName</strong> sobre el grupo <strong>@Model.GroupName</strong> </p><br>
                    <p>@Model.Criterion</p>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>

    </div>
</div>
