@model MOROPO.FCBC.SGI.Models.View.CreationGroupMemberDisplayViewModel

<div class="modal fade" id="delete-member-@Model.ArtistId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-member-@Model.ArtistId-title">Eliminar Membresia</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Html.BeginForm("removemember", "creationgroups", null, FormMethod.Post, true, null))
            {
                @Html.HiddenFor(model => model.CreationGroupId)

                @Html.HiddenFor(model => model.ArtistId)

                <div class="modal-body">
                    <p>Está seguro que desea eliminar la membresia al artista <b>@Model.Name</b> de nombre artístico <b>@Model.Alias</b>?</p>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>