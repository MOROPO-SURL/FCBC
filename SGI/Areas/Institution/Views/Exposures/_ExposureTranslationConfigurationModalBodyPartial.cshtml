@model MOROPO.FCBC.SGI.Models.View.ExposureTranslationInputViewModel

<div class="modal-body">
    @Html.HiddenFor(model => model.ExposureId)

    <div class="mb-3">
        @Html.LabelFor(model => model.TranslatableLanguage, new { @class = "control-label" })
        @Html.TextBoxFor(model => model.TranslatableLanguage, new { @class = "form-control", @readonly = "readonly"})
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Name, new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Name, new { @class = "form-control"})
    </div>

    <div>
        @Html.LabelFor(model => model.Description, new { @class = "control-label" })
        @Html.TextAreaFor(model => model.Description, 10, 0, new { @class = "form-control"})
    </div>
</div>