@model MOROPO.FCBC.SGI.Models.View.EditExposureCuratorshipViewModel

@{
    ViewData["Title"] = "Modificar Exposición (Curadores)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Exposiciones",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link rel="stylesheet" href="~/lib/bootstrap-combobox/css/bootstrap-combobox.css" />
    <style type="text/css">
        .member-img {
            width: 85%;
            max-height: 330px;
        }

        .dropdown-toggle {
            border-radius: 0.25rem;
            border: 1px solid #ced4da;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            margin-left: -1px;
            line-height: 36px;
        }

        .dropdown-toggle::after {
            margin: 0 5px;
        }

        ul.dropdown-menu{
            width: 100%;
        }
    </style>
}

@section scripts {
    <script src="~/lib/bootstrap-combobox/js/bootstrap-combobox.js"></script>
    <script type="text/javascript">
        $('.member-select').combobox();
    </script>

}

<div class="card mb-3">
    <div class="card-header">
        <h4>Modificar Exposición</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("edit", @Model.Exposure.Id)">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Curadores</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editexhibits", @Model.Exposure.Id)">Obras</a>
            </li>
        </ul>
    </div>
    <div class="card-body">        
        <div class="alert alert-dark mb-4">
            <details>
                <summary class="h4 mb-0">@Model.Exposure.Name</summary>
                <hr />
                <dl class="mb-0">
                    <dt>Descripción</dt>                                        
                    @if (Model.Exposure.Description == null)
                    {
                        <dd>-</dd>
                    }
                    else 
                    {
                        <dd>@Model.Exposure.Description</dd>
                    }
                </dl>
            </details>                
        </div>
        @if (Model.Employees.Count() != 0)
        {
            <div class="row">
                @foreach (var item in Model.Employees)
                {
                    <div class="col-lg-2 col-md-3 col-sm-4" style="margin-bottom: 20px;">
                        @if (item.ImageId != null)
                        {
                            <img src="~/media/images/@item.ImageId.@item.ImageExtension" class="img-fluid img-thumbnail rounded-circle" />
                        }
                        else
                        {
                            <img src="~/img/default-person-picture.jpg" class="img-fluid img-thumbnail rounded-circle" />
                        }
                        <div class="text-center mt-2">
                            @if (string.IsNullOrEmpty(item.LastName))
                            {
                                <div>@item.Name</div>
                            }
                            else
                            {
                                <div>@item.Name @item.LastName</div>
                            }
                            <div class="mt-2">
                                <button role="button" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-@item.Id"><span class="mdi mdi-trash-can-outline"></span>Eliminar</button>
                            </div>
                        </div>
                    </div>
                    <div class="modal fade" id="delete-@item.Id" tabindex="-1" role="dialog" aria-labelledby="delete-@item.Id-lable" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                @using (Html.BeginForm("removecurator", "exposures", new { key = Model.Exposure.Id }, FormMethod.Post, true, new { @class = "modal-content" }))
                                {
                                    @Html.Hidden("employeeId", item.Id)

                                    <div class="modal-header">
                                        <h4 class="modal-title" id="delete-image-@item.Id-lable">Eliminar Curador</h4>
                                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                    </div>
                                    <div class="modal-body">
                                        <p class="mb-0">Esta seguro que desea eliminar el curador seleccionado?</p>
                                    </div>
                                    <div class="modal-footer" style="margin-top: 0;">
                                        <button type="submit" class="btn btn-danger">Eliminar</button>
                                        <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-muted font-italic">Este sala aún no tiene cuadores, haga clic en el boton agregar para comenzar ...</div>
        }
    </div>
    <div class="card-footer">
        <button type="button" class="btn btn-primary" href="#" data-toggle="modal" data-target="#add-employee">Agregar</button>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>    
    <div class="modal fade" id="add-employee" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="add-employee-title">Agregar Curador</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                @using (Html.BeginForm("addcurator", "exposures", new { key = Model.Exposure.Id }, FormMethod.Post, true, null))
                {
                    <div class="modal-body">
                        @if (Model.AvailableEmployeeSelectItems.Length > 0)
                        {
                            <div>
                                @Html.Label("employeeId", "Curador", new { @class = "control-label" })
                                @Html.DropDownList("employeeId", Model.AvailableEmployeeSelectItems, "Escribar para buscar trabajador ...", new { @class = "form-control member-select" })
                            </div>
                        }else{
                            <div class="text-muted font-italic">No hay trabajadores disponibles para agregar como curador</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Agregar</button>
                        <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>