@model MOROPO.FCBC.SGI.Models.View.ExposureInputViewModel

@{
    ViewData["Title"] = "Agregar Exposición";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Exposiciones",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link href="~/lib/gijgo/combined/css/gijgo.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" type="text/css" href="~/lib/bootstrap-colorpicker/dist/css/bootstrap-colorpicker.min.css" />
}
    
@section scripts {
    <script src="~/lib/gijgo/combined/js/gijgo.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/bootstrap-colorpicker/dist/js/bootstrap-colorpicker.min.js"></script>

    <script type="text/javascript">
        $('#StartAt').datepicker({
            uiLibrary: 'bootstrap4',
            modal: true,
            header: true,
            footer: true,
            format: 'dd/mm/yyyy',
            value: '@Model.StartAt?.ToShortDateString()'
        });
        $('#EndAt').datepicker({
            uiLibrary: 'bootstrap4',
            modal: true,
            header: true,
            footer: true,
            format: 'dd/mm/yyyy',
            value: '@Model.EndAt?.ToShortDateString()'
        });
        $('.colorpicker-element').colorpicker();
    </script>    
}
    
@using (Html.BeginForm("create", "exposures", new { Area = "institution" }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="card mb-3">
        <div class="card-header"><h4 class="mb-0">@ViewData["Title"]</h4></div>

        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
            </div>
            <div class="row">                
                <div class="col-md-6 mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.Enabled) Habilitada?
                            @Html.ValidationMessageFor(model => model.Enabled)
                        </label>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.StartAt, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.StartAt, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.StartAt, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.EndAt, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.EndAt, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.EndAt, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.FrameBaseColor, new { @class = "control-label" })
                    <div class="input-group colorpicker-element">
                        @Html.TextBoxFor(model => model.FrameBaseColor, new { @class = "form-control", @readonly = "readonly" })
                        <span class="input-group-append">
                            <span class="input-group-text colorpicker-input-addon"><i></i></span>
                        </span>
                    </div>
                    @Html.ValidationMessageFor(model => model.FrameBaseColor, null, new { @class = "text-danger" })
                </div>
            </div>
            <div>
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, 8, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Agregar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
        </div>
    </div>
}



