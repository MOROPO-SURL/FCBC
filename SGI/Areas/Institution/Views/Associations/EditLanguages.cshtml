@using MOROPO.SAPRESSC.Middleware.Identity.Persistence.Enumerations;

@model MOROPO.FCBC.SGI.Models.View.AssociationLanguageManagerViewModel

@{
    ViewData["Title"] = "Editar Editar Asociaciones (Idiomas)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Obras de Artes Visuales",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<div class="card" style="margin-bottom: 20px;">
    <div class="card-header">
        <h4>@ViewData["Title"]</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" href="#">Información</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("contacts", @Model.Association.Id)">Contactos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Idiomas</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="alert alert-dark mb-4">
            <details>
                <summary class="h4 mb-0">@Model.Association.Name</summary>
                <hr />
                <div class="row no-gutters">
                    <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                        @if (Model.Association.ImageId != null)
                        {
                            <img class="img-thumbnail" src="~/media/images/@Model.Association.ImageId.@Model.Association.ImageExtension" />
                        }
                        else
                        {
                            <img class="img-thumbnail" src="~/img/default-organization-picture.png" />
                        }
                    </div>
                    <div class="col-lg-10 col-md-8 col-sm-6">
                        <dl>
                            <dt>Fecha de Creación</dt>
                            @if (Model.Association.BornDate == null)
                            {
                                <dd>--</dd>
                            }
                            else
                            {
                                <dd>@Model.Association.BornDate.Value.ToShortDateString()</dd>
                            }
                        </dl>
                        <dl class="mb-0">
                            <dt>Acerca de</dt>
                            @if (Model.Association.About == null)
                            {
                                <dd>--</dd>
                            }
                            else
                            {
                                <dd>@Model.Association.About</dd>
                            }
                        </dl>
                    </div>
                </div>
            </details>
        </div>
        <div class="modal fade" id="add-attachment" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="add-attachment-title">Agregar Idioma</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    @using (Html.BeginForm("AddLanguage", "Associations", new { key = Model.Association.Id }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
                    {
                        var artWorkLanguagesInputViewModel = new MOROPO.FCBC.SGI.Models.View.InstitutionsLanguagesInputViewModel();
                        artWorkLanguagesInputViewModel.NotSelectedLanguages = Model.NotSelectedLanguage;
                        artWorkLanguagesInputViewModel.GeneralId = Model.Association.Id;

                        @await Html.PartialAsync("../../../../Views/Shared/Partials/_AddInstitutionsLanguageModalBodyPartial", artWorkLanguagesInputViewModel)
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Agregar</button>
                            <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        @if (Model.Translations.Count() <= 0)
        {
            <p class="text-muted mb-0">Sin elementos que mostrar</p>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model.Translations)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="modal fade" id="delete-attachment-@item.Association.Id-@item.TranslatableLanguage.ToString()" tabindex="-1" role="dialog" aria-labelledby="delete-attachment-@item.Association.Id-lable" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    @using (Html.BeginForm("DeleteLanguage", "Associations", new { key = Model.Association.Id }, FormMethod.Post, true, new { @class = "modal-content" }))
                                    {

                                        @Html.Hidden("AssociationId", Model.Association.Id)
                                        @Html.Hidden("translatableLanguage", item.TranslatableLanguage)

                                        <div class="modal-header">
                                            <h4 class="modal-title" id="delete-attachment-@item.Association.Id-lable">Eliminar Idioma</h4>
                                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                        </div>
                                        <div class="modal-body">
                                            <p>Esta seguro que desea eliminar el idioma @GlobalViewLocalizationHelper.Localize(item.TranslatableLanguage.ToString())?</p>
                                        </div>
                                        <div class="modal-footer" style="margin-top: 0;">
                                            <button type="submit" class="btn btn-danger">Eliminar</button>
                                            <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-2">

                            <h4>@item.AssociationLanguege.Name</h4>

                            <p style="color: #6c757d; word-wrap: break-word;">@item.AssociationLanguege.TranslatableLanguage.ToString()</p>
                            <div class="mt-3">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-danger" href="#" data-toggle="modal" data-target="#delete-attachment-@item.Association.Id-@item.TranslatableLanguage.ToString()">Eliminar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <div class="card-footer">
        <a class="btn btn-primary" href="#" data-toggle="modal" data-target="#add-attachment">Agregar</a>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
</div>




