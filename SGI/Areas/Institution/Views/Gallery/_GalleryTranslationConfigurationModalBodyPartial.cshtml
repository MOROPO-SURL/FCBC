@model MOROPO.FCBC.SGI.Models.View.GalleryTranslationInputViewModel

<div class="modal-body">
    @Html.HiddenFor(model => model.GalleryId)

    <div class="mb-3">
        @Html.LabelFor(model => model.TranslatableLanguage, new { @class = "control-label" })
        @Html.TextBoxFor(model => model.TranslatableLanguage, new { @class = "form-control", @readonly = "readonly"})
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Name, new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Name, new { @class = "form-control"})
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.About, new { @class = "control-label" })
        @Html.TextAreaFor(model => model.About, 8, 0, new { @class = "form-control"})
    </div>    

    <div>
        @Html.LabelFor(model => model.History, new { @class = "control-label" })
        @Html.TextAreaFor(model => model.History, 20, 0, new { @class = "form-control"})
    </div>
</div>