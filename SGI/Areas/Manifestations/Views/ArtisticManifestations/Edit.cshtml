@using MOROPO.SAPRESSC.Core.Common.Models.View;

@model MOROPO.FCBC.SGI.Models.View.ArtisticManifestationInputViewModel

@{
    ViewData["Title"] = "Modificar Manifestación de Artes Plásticas";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Manifestaciones de Artes Plásticas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link href="~/lib/gijgo/combined/css/gijgo.css" rel="stylesheet" type="text/css" />
}

    @section scripts {
    <script src="~/lib/gijgo/combined/js/gijgo.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var selectedNode;
            var dataId = $("#GroupId").val();
            var tree = $('#tree').tree({
                uiLibrary: 'bootstrap4',
                dataSource: @Html.Raw(Model.SerializedTree),
                primaryKey: 'id',
                border: true
            });
            selectedNode = tree.getNodeById(dataId);
            tree.expandAll();
            tree.on('select', function (e, node, id) {
                $('#GroupId').val(id);
            });
            tree.on('unselect', function (e, node, id) {
                $('#GroupId').val(null);
            });
            tree.select(selectedNode);
        });
    </script>
}

@using (Html.BeginForm("edit", "artisticmanifestations", new { Area = "manifestations", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card mb-3">
        <div class="card-header"><h4>@ViewData["Title"]</h4></div>

        <div class="card-body">

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.GroupId, new { @class = "control-label" })
                    @Html.HiddenFor(model => model.GroupId)
                    @if (Model.SerializedTree == "[]")
                    {
                        <div class="text-muted">Sin elementos para seleccionar</div>
                    }
                    else
                    {
                        <div id="tree"></div>
                    }
                    @Html.ValidationMessageFor(model => model.GroupId, null, new { @class = "text-danger" })
                </div>
            </div>
            <div>
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}