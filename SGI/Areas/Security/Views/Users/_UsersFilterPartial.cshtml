@model MOROPO.SAPRESSC.Middleware.Security.Essential.Web.Backend.Models.Filter.UsersFilterModel

@using (Html.BeginForm("filter", "users", new { Area = "security" }, FormMethod.Post, true, null))
{
    <fieldset>
        <legend class="border-bottom">Filtro de Usuarios</legend>
        <div class="mb-4">
            @Html.Label("Id", "Nombre de Usuario", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Id, new { @class = "form-control" })
        </div>
        <div>
            <button type="submit" class="btn btn-sm btn-primary"><span class="mdi mdi-filter"></span> Filtrar</button>
            <button type="button" class="btn btn-sm btn-light filter-form-reseter"><span class="mdi mdi-filter-remove-outline"></span> Limpiar</button>
        </div>
    </fieldset>
}
