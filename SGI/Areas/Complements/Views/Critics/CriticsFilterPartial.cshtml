@model MOROPO.FCBC.SGI.Models.Filter.CriticFilterModel

@using (Html.BeginForm("filter", "critics", new { Area = "complements" }, FormMethod.Post, true, null))
{
    <fieldset>
        <legend>Filtro de Críticos</legend>
        <div style="margin-bottom: 20px;">
            @Html.Label("Id", "Nombre", new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Id, new { @class = "form-control" })
        </div>

        <div>
            <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-filter"></span> Filtrar</button>
        </div>
    </fieldset>
}