@model MOROPO.FCBC.SGI.Models.View.CriticDisplayViewModel

<!-- Modal -->
<div class="modal fade" id="descrip-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Detalles</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        @if (Model.ImageId != System.Guid.Empty)
                        {
                            <img src="~/media/images/@Model.ImageId.@Model.ImageExtension" class="card-img-top" id="ImageFilePreview" />
                        }
                        else
                        {
                            <img src="~/media/images/default-person.png" class="card-img-top" id="ImageFilePreview" />
                        }
                    </div>
                </div>
                <h5>@Html.DisplayNameFor(model => model.Name)</h5>
                <p>@Model.Name</p>
                <h5>@Html.DisplayNameFor(model => model.LastName)</h5>
                <p>@Model.LastName</p>
                <h5>@Html.DisplayNameFor(model => model.Sex)</h5>
                <p>@Html.DisplayName(GlobalViewLocalizationHelper.Localize(Model.Sex.ToString(), ViewLocalizer))</p>
                <h5>@Html.DisplayNameFor(model => model.CivilStatus)</h5>
                <p>@Html.DisplayName(GlobalViewLocalizationHelper.Localize(Model.CivilStatus.ToString(), ViewLocalizer))</p>
                <h5>@Html.DisplayNameFor(model => model.Alias)</h5>
                <p>@Model.Alias</p>
                <h5>@Html.DisplayNameFor(model => model.About)</h5>
                <p>@Model.About</p>
            </div>
        </div>
    </div>
</div>