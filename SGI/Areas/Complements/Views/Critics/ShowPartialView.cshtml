@model MOROPO.FCBC.SGI.Models.View.CriticDisplayViewModel

<!-- Modal -->
<div class="modal fade" id="descrip-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Detalles</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                @if (Model.ImageId != null)
                {
                    <img src="~/media/images/@Model.ImageId.@Model.ImageExtension" width="100" class="img-thumbnail w-50 rounded-circle" />
                }
                else
                {
                    <img src="~/img/default-person-picture.jpg" class="img-thumbnail w-50 rounded-circle" />
                }
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <h5>@Html.DisplayNameFor(model => model.Name)</h5>
                        <p>@Model.Name</p>
                    </div>
                    <div class="col-md-6">
                        <h5>@Html.DisplayNameFor(model => model.LastName)</h5>
                        <p>@Model.LastName</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <h5>@Html.DisplayNameFor(model => model.Sex)</h5>
                        <p>@Html.DisplayName(GlobalViewLocalizationHelper.Localize(Model.Sex.ToString(), ViewLocalizer))</p>
                        </div>
                    <div class="col-md-6">
                        <h5>@Html.DisplayNameFor(model => model.Alias)</h5>
                        <p>
                        @if (Model.Alias != null)
                        {
                            <span>@Model.Alias</span>
                        }
                        else
                        {
                            <span>--</span>
                        }
                        </p>
                    </div>
                </div>
                <h5>@Html.DisplayNameFor(model => model.About)</h5>
                <p class="mb-0">
                @if (Model.About != null)
                {
                    <span>@Model.About</span>
                }
                else
                {
                    <span>--</span>
                }
                </p>
            </div>
        </div>
    </div>
</div>