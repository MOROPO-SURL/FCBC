@using SmartSolucionesCuba.SAPRESSC.Middleware.Identity.Persistence.Enumerations;

@model MOROPO.FCBC.SGI.Models.View.CriticInputViewModel

@{
    ViewData["Title"] = "Editar Crítico";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Críticos",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {

    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }
    </style>
}

    @section scripts {
    <script type="text/javascript">

        $(function () {
            $(document).on("change", "#ImageFile", function () {
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function () {
                        $('#ImageFilePreview').attr('src', this.result);
                    }
                }

            });
        });
    </script>

    @{
        /*await Html.RenderPartialAsync("_ValidationScriptsPartial");*/
    }
    }

@using (Html.BeginForm("edit", "critics", new { Area = "complements", key = string.Empty }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(model => model.Id)

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header"><h4>@ViewData["Title"]</h4></div>

        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-4" style="margin-bottom: 20px;">
                    <div class="card">
                        @if (Model.ImageId != System.Guid.Empty)
                        {
                            <img src="~/media/images/@Model.ImageId.@Model.ImageExtension" class="card-img-top" id="ImageFilePreview" />
                        }
                        else
                        {
                            <img src="~/media/images/default-person.png" class="card-img-top" id="ImageFilePreview" />
                        }

                        <label class="btn btn-light" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-bottom: 0;">
                            @GlobalViewLocalizationHelper.Localize("Upload", ViewLocalizer) ...
                            @Html.EditorFor(model => model.ImageFile)
                        </label>
                    </div>
                    @Html.ValidationMessageFor(model => model.ImageFile, null, new { @class = "text-danger" })
                </div>
                <div class="col-lg-9 col-md-8 col-sm-8" style="margin-bottom: 20px;">
                    <div style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                    </div>
                    <div style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.LastName, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.LastName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.LastName, null, new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Sex, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.Sex, new SelectListItem[] { new SelectListItem(GlobalViewLocalizationHelper.Localize("Male", ViewLocalizer), Sex.Male.ToString()), new SelectListItem(GlobalViewLocalizationHelper.Localize("Famale", ViewLocalizer), Sex.Famale.ToString()) }, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Sex, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.CivilStatus, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.CivilStatus, new SelectListItem[] { new SelectListItem(GlobalViewLocalizationHelper.Localize("Single", ViewLocalizer), CivilStatus.Single.ToString()), new SelectListItem(GlobalViewLocalizationHelper.Localize("Married", ViewLocalizer), CivilStatus.Married.ToString()), new SelectListItem(GlobalViewLocalizationHelper.Localize("Divorced", ViewLocalizer), CivilStatus.Divorced.ToString()), new SelectListItem(GlobalViewLocalizationHelper.Localize("Widower", ViewLocalizer), CivilStatus.Widower.ToString()) }, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.CivilStatus, null, new { @class = "text-danger" })
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.About, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.About, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.About, null, new { @class = "text-danger" })
            </div>

        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-default" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}