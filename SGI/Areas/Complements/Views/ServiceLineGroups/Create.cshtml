@using MOROPO.SAPRESSC.Core.Common.Models.View;

@model MOROPO.FCBC.SGI.Models.View.ServiceLineGroupInputViewModel

@{
    ViewData["Title"] = "Agregar Grupo de Líneas de Servicio";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Grupos de Líneas de Servicio",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link href="~/lib/gijgo/combined/css/gijgo.css" rel="stylesheet" type="text/css" />
}

@section scripts {
    <script src="~/lib/gijgo/combined/js/gijgo.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            
            var tree = $('#tree').tree({
                uiLibrary: 'bootstrap4',
                dataSource: @Html.Raw(Model.SerializedTree),
                primaryKey: 'id',
                border: true
            });

            tree.expandAll();

            tree.on('select', function (e, node, id) {
                $('#ParentId').val(id);
            });

            tree.on('unselect', function (e, node, id){
                $('#ParentId').val(null);
            });
        });
    </script>
}

@using (Html.BeginForm("create", "servicelinegroups", new { Area = "complements" }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="card mb-3">
        <div class="card-header"><h4 class="mb-0">@ViewData["Title"]</h4></div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.ParentId, new { @class = "control-label" })
                    @Html.HiddenFor(model => model.ParentId)                        
                    @if (Model.SerializedTree == "[]")
                    {
                        <div class="text-muted">Sin elementos para seleccionar</div>
                    }
                    else
                    {
                        <div id="tree"></div>
                    }
                    @Html.ValidationMessageFor(model => model.ParentId, null, new { @class = "text-danger" })
                </div>
            </div>
            <div>
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Agregar</button>
            <a class="btn btn-default" href="@Url.Action("index")">Cancelar</a>
        </div>
    </div>
}
