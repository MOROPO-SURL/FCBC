@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View;

@model MOROPO.FCBC.SGI.Models.View.ArtisticManifestationInputViewModel

@{
    ViewData["Title"] = "Modificar Manifestación Artística";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Manifestaciones Artíticas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link href="~/lib/gijgo/combined/css/gijgo.css" rel="stylesheet" type="text/css" />
}

    @section scripts {
    <script src="~/lib/gijgo/combined/js/gijgo.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var selectedNode;
            var dataId = $("#ParentId").val();
            var tree = $('#tree').tree({
                uiLibrary: 'bootstrap4',
                dataSource: @Html.Raw(Model.SerializedTree),
                primaryKey: 'id',
                border: true
            });
            selectedNode = tree.getNodeById(dataId);
            tree.expandAll();
            tree.on('select', function (e, node, id) {
                $('#ParentId').val(id);
            });
            tree.select(selectedNode);
        });
    </script>
}

@using (Html.BeginForm("edit", "artisticmanifestations", new { Area = "complements", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header"><h4>@ViewData["Title"]</h4></div>

        <div class="card-body">

            <div class="row">
                <div class="col-sm-4 style=" margin-bottom: 20px;"">
                    <div>
                        @Html.LabelFor(model => model.Name)
                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger", style = "display: inline-block;" })
                    </div>
                </div>
                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.ParentId, new { @class = "control-label" })
                    @Html.HiddenFor(model => model.ParentId)
                    <div id="tree"></div>
                    @Html.ValidationMessageFor(model => model.ParentId, null, new { @class = "text-danger", style = "display: inline-block;" })
                </div>
            </div>

        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-default" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}