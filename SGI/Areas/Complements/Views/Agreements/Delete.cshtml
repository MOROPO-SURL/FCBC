@using MOROPO.SAPRESSC.Core.Common.Models.View;

@model MOROPO.FCBC.SGI.Models.View.AgreementDisplayViewModel;

@{
    ViewData["Title"] = "Eliminar Acuerdo";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Acuerdos",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<h3>Esta seguro que desea eliminar el acuerdos del CA detallado a continuación?</h3>
<dl>

    <dt>@Html.DisplayNameFor(model => model.Number)</dt>
    <dd>@Html.DisplayFor(model => model.Number)</dd>
    <dt>@Html.DisplayNameFor(model => model.Title)</dt>
    <dd>@Html.DisplayFor(model => model.Title)</dd>
    <dt>@Html.DisplayNameFor(model => model.ReleaseAt)</dt>
    <dd>@Model.ReleaseAt.ToShortDateString()</dd>
    <dt>@Html.DisplayNameFor(model => model.Description)</dt>
    <dd>
        @if (string.IsNullOrEmpty(Model.Description))
        {
            <span>--</span>
        }
        else
        {
            <span>@Model.Description</span>
        }
    </dd>
</dl>
@using (Html.BeginForm("delete", "agreements", new { Area = "complements", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.HiddenFor(model => model.Id)
    <div>
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
    </div>
}

