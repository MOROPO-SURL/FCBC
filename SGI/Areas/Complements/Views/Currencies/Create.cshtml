@using MOROPO.SAPRESSC.Core.Common.Models.View;
@using MOROPO.FCBC.SGI.Persistence.Enumerations

@model MOROPO.FCBC.SGI.Models.View.CurrencyInputViewModel

@{
    ViewData["Title"] = "Agregar Monedas";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Premios",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("create", "currencies", new { Area = "complements" }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header"><h4 class="mb-0">@ViewData["Title"]</h4></div>

        <div class="card-body">

            <div class="row">
                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>

                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Symbol, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Symbol, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Symbol, null, new { @class = "text-danger" })
                </div>

                <div class="col-md-6" style="margin-bottom: 20px;">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.IsSpacedSymbol)
                            @Html.LabelFor(model => model.IsSpacedSymbol, new { @class = "control-label" })
                            @Html.ValidationMessageFor(model => model.IsSpacedSymbol)
                        </label>
                    </div>
                    
                </div>

                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Position, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.Position, new SelectListItem[] { new SelectListItem(GlobalViewLocalizationHelper.Localize(CurrencySymbolPosition.Prefix.ToString(), ViewLocalizer), CurrencySymbolPosition.Prefix.ToString()), new SelectListItem(GlobalViewLocalizationHelper.Localize(CurrencySymbolPosition.Sufix.ToString(), ViewLocalizer), CurrencySymbolPosition.Sufix.ToString())}, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Position, null, new { @class = "text-danger" })
                </div>
            </div>




        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Agregar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
        </div>
    </div>
}
