@using MOROPO.SAPRESSC.Core.Common.Models.View;

@model MOROPO.FCBC.SGI.Models.View.UnitMeasurementInputViewModel;

@{
    ViewData["Title"] = "Modificar Unidad de Medida";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Unidades de Medidas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("edit", "unitmeasurements", new { Area = "complements", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card ,b-3">
        <div class="card-header"><h4 class="mb-0">@ViewData["Title"]</h4></div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Symbol, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Symbol, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Symbol, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-md-0 mb-sm-3">
                    @Html.LabelFor(model => model.MilimetersRatio, string.Format("{0} (opcional)", GlobalViewLocalizationHelper.Localize("MilimetersRatio")), new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.MilimetersRatio, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.MilimetersRatio, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.GramsRatio, string.Format("{0} (opcional)", GlobalViewLocalizationHelper.Localize("GramsRatio")), new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.GramsRatio, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.GramsRatio, null, new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-ight" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}
