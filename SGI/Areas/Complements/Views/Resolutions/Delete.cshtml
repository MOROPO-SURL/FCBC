@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View;

@model MOROPO.FCBC.SGI.Models.View.ResolutionDisplayViewModel;

@{
    ViewData["Title"] = "Eliminar Resolución";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Resoluciones",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<h3>Esta seguro que desea eliminar el reconicimiento detallado a continuación?</h3>
<dl>

    <dt>@Html.DisplayNameFor(model => model.NumberResolution)</dt>
    <dd>@Html.DisplayFor(model => model.NumberResolution)</dd>
    <dt>@Html.DisplayNameFor(model => model.Title)</dt>
    <dd>@Html.DisplayFor(model => model.Title)</dd>    
</dl>
@using (Html.BeginForm("delete", "Resolutions", new { Area = "complements", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.HiddenFor(model => model.Id)
    <div>
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-default" href="@Url.Action("index")">Cancelar</a>
    </div>
}

