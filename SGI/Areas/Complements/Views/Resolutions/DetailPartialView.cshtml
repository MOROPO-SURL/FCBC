@model MOROPO.FCBC.SGI.Models.View.ResolutionDisplayViewModel

<!-- Modal -->
<div class="modal fade" id="descrip-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Detalles</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <h5>@Html.DisplayNameFor(model => model.NumberResolution)</h5>
                <p>@Model.NumberResolution</p>
                <h5>@Html.DisplayNameFor(model => model.Title)</h5>
                <p>@Model.Title</p>
                <h5>@Html.DisplayNameFor(model => model.ResolutionDate)</h5>
                <p>@Model.ResolutionDate</p>
                <h5>@Html.DisplayNameFor(model => model.Description)</h5>
                @if (string.IsNullOrEmpty(Model.Description))
                {
                    <span>--</span>
                }
                else
                {                    
                    <span>@Model.Description</span>
                }                            
            </div>
        </div>
    </div>
</div>