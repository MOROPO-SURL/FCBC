@model MOROPO.SAPRESSC.Core.Web.Frontend.Models.View.PaginationViewModel<MOROPO.FCBC.SGI.Persistence.Entities.Distinction, System.Guid, MOROPO.FCBC.SGI.Models.View.DistinctionDisplayViewModel>

@{
    ViewData["Title"] = "Administración de Distinciones";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<a class="btn btn-primary float-right" href="@Url.Action("create")"><span class="mdi mdi-plus"></span> Agregar</a>
<div class="clearfix mb-3"></div>

@if (Model.MaxPageCount > 0)
{
    if (Model.HasNext || Model.HasPrevious)
    {
        var paginationStart = (Model.Page - 1) * Model.Limit + 1;
        var paginationEnd = paginationStart - 1 + Model.List.Count;

        <div class="text-center">
            <ul class="pagination justify-content-center" style="margin: 0;">
                @if (Model.HasPrevious)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", 1}})">Primero</a></li>
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                }
                else
                {
                    <li class="disabled page-item"><a class="page-link" href="#">Primero</a></li>
                    <li class="disabled page-item"><a class="page-link" href="#">&laquo;</a></li>
                }

                @if (Model.MaxPageCount > 5)
                {
                    if (Model.Page > 3)
                    {
                        if (Model.MaxPageCount - Model.Page < 3)
                        {
                            for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                        else
                        {
                            for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                    }
                    else
                    {
                        for (var i = 1; i <= 5; i++)
                        {
                            if (i == Model.Page)
                            {
                                <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                            }
                            else
                            {
                                <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                            }
                        }
                    }
                }
                else
                {
                    for (var i = 1; i <= Model.MaxPageCount; i++)
                    {
                        if (i == Model.Page)
                        {
                            <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                        }
                    }
                }

                @if (Model.HasNext)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">Ultimo</a></li>
                }
                else
                {
                    <li class="disabled page-item"><a class="page-link" href="#">&raquo;</a></li>
                    <li class="disabled page-item"><a class="page-link" href="#">Ultimo</a></li>
                }
            </ul>
            <div class="text-info" style="margin-top: 10px; margin-bottom: 20px;">
                <span style="font-weight: 600;">Página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
            </div>
        </div>
    }

    @foreach (var item in Model.List)
    {
        <div class="card border-primary mb-2 d-block  d-sm-none">
            <div class="card-body text-justify">
                <div class="mb-2">
                    <span class="font-weight-bold">
                        Nombre:
                    </span>
                    @item.Name
                </div>
                <div>
                    <div class="btn-group">
                        <button class="btn btn-light" title="@Model" data-toggle="modal" data-target="#descrip-@item.Id"><span class="mdi mdi-file-eye-outline  "></span><span>Detalles</span></button>
                        <a role="button" href="@Url.Action("edit", new { key = item.Id })" class="btn btn-light" title="Editar"><span class="mdi mdi-square-edit-outline"></span><span class="hidden-xs"> Modificar</span></a>
                        <a role="button" href="@Url.Action("delete", new {key = item.Id})" class="btn btn-danger"><span class="mdi mdi-trash-can-outline"></span> Eliminar</a>
                    </div>
                </div>
            </div>
        </div>
            
        <div class="modal fade" id="descrip-@item.Id" tabindex="-1" role="dialog" aria-labelledby="descrip-@item.Id-label" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="descrip-@item.Id-label">Detalles</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <h5>@GlobalViewLocalizationHelper.Localize("Name")</h5>
                        <p>@item.Name</p>
                        <h5>@GlobalViewLocalizationHelper.Localize("Description")</h5>
                        @if (string.IsNullOrEmpty(item.Description))
                        {
                            <span>--</span>
                        }
                        else
                        {
                            <span>@item.Description</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="d-none d-sm-block" style="border: 1px solid #DDD; border-radius: 4px;">
        <table class="table" style="margin: 0;">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th style="width: 1px;">Opciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td style="vertical-align: middle;" title="Manifestacin Artistica ">@item.Name</td>
                        <td style="vertical-align: middle;">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-light" title="@Model" data-toggle="modal" data-target="#descrip-@item.Id"><span class="mdi mdi-file-eye-outline"></span><span>Detalles</span></button>
                                <a role="button" href="@Url.Action("edit", new { key = item.Id })" class="btn btn-light" title="Editar"><span class="mdi mdi-square-edit-outline"></span><span class="hidden-xs"> Modificar</span></a>
                                <a role="button" href="@Url.Action("delete", new {key = item.Id})" class="btn btn-danger"><span class="mdi mdi-trash-can-outline"></span> Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    if (Model.HasNext || Model.HasPrevious)
    {
        var paginationStart = (Model.Page - 1) * Model.Limit + 1;
        var paginationEnd = Model.List.Count;

        <div class="text-center" style="margin: 20px 0;">
            <div class="text-info" style="margin-bottom: 10px; margin-top: 20px;">
                <span style="font-weight: 600;">Página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
            </div>
            <ul class="pagination justify-content-center" style="margin: 0;">
                @if (Model.HasPrevious)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", 1}})">Primero</a></li>
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                }
                else
                {
                    <li class="disabled page-item"><a class="page-link" href="#">Primero</a></li>
                    <li class="disabled page-item"><a class="page-link" href="#">&laquo;</a></li>
                }

                @if (Model.MaxPageCount > 5)
                {
                    if (Model.Page > 3)
                    {
                        if (Model.MaxPageCount - Model.Page < 3)
                        {
                            for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                        else
                        {
                            for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                    }
                    else
                    {
                        for (var i = 1; i <= 5; i++)
                        {
                            if (i == Model.Page)
                            {
                                <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                            }
                            else
                            {
                                <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                            }
                        }
                    }
                }
                else
                {
                    for (var i = 1; i <= Model.MaxPageCount; i++)
                    {
                        if (i == Model.Page)
                        {
                            <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                        }
                    }
                }

                @if (Model.HasNext)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">Ultimo</a></li>
                }
                else
                {
                    <li class="disabled page-item"><a class="page-link" href="#">&raquo;</a></li>
                    <li class="disabled page-item"><a class="page-link" href="#">Ultimo</a></li>
                }
            </ul>
        </div>
    }
}
else
{
    <div style="border: 1px solid #DDD; border-radius: 4px;">
        <table class="table" style="margin: 0;">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th style="width: 1px;">Opciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="6"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                </tr>
            </tbody>
        </table>
    </div>
}