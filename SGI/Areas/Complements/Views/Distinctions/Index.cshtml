@model SmartSolucionesCuba.SAPRESSC.Core.Web.Frontend.Models.View.PaginationViewModel<MOROPO.FBCB.SGI.Persistence.Entities.Distinction, System.Guid, MOROPO.FCBC.SGI.Models.View.DistinctionDisplayViewModel>

@{
    ViewData["Title"] = "Administración de Distinciones";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        .integrity-icon {
            font-size: 18px;
            top: 2px;
            margin-left: 8px;
            margin-right: 8px;
        }
    </style>
}

    <div class="row" style="margin-bottom: 20px;">
        <div><a class="btn btn-primary float-right" href="@Url.Action("create")"><span class="mdi mdi-plus"></span> Agregar</a></div>
    </div>

@if (Model.MaxPageCount > 0)
{
    if (Model.HasNext || Model.HasPrevious)
    {
        var paginationStart = (Model.Page - 1) * Model.Limit + 1;
        var paginationEnd = paginationStart - 1 + Model.List.Count;

        <div class="text-center">
            <ul class="pagination" style="margin: 0;">
                @if (Model.HasPrevious)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&laquo;</a></li>
                }

                @if (Model.MaxPageCount > 5)
                {
                    if (Model.Page > 3)
                    {
                        if (Model.MaxPageCount - Model.Page < 3)
                        {
                            for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                        else
                        {
                            for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                    }
                    else
                    {
                        for (var i = 1; i <= 5; i++)
                        {
                            if (i == Model.Page)
                            {
                                <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                            }
                            else
                            {
                                <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                            }
                        }
                    }
                }
                else
                {
                    for (var i = 1; i <= Model.MaxPageCount; i++)
                    {
                        if (i == Model.Page)
                        {
                            <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                        }
                        else
                        {
                            <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                        }
                    }
                }

                @if (Model.HasNext)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&raquo;</a></li>
                }
            </ul>
            <div class="text-info" style="margin-top: 10px; margin-bottom: 20px;">
                <span style="font-weight: 600;">Página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
            </div>
        </div>
    }

    <div style="border: 1px solid #DDD; border-radius: 4px;">
        <table class="table" style="margin: 0;">
            <thead>
                <tr>
                    <th width="36px;"><span class="mdi mdi-shield-lock integrity-icon" title="Integridad"></span></th>
                    <th>Distinción</th>
                    <th style="width: 184px;">Opciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td></td>
                        <td style="vertical-align: middle;" title="Manifestacin Artistica ">@item.Name</td>
                        <td style="vertical-align: middle;">
                            <div class="btn-group btn-group-sm">
                                <a role="button" href="@Url.Action("edit", new { key = item.Id })" class="btn btn-light" title="Editar"><span class="mdi mdi-square-edit-outline"></span><span class="hidden-xs"> Modificar</span></a>&nbsp;|&nbsp;
                                <a role="button" href="@Url.Action("delete", new {key = item.Id})" class="btn btn-danger"><span class="mdi mdi-trash-can-outline"></span> Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    if (Model.HasNext || Model.HasPrevious)
    {
        var paginationStart = (Model.Page - 1) * Model.Limit + 1;
        var paginationEnd = Model.List.Count;

        <div class="text-center" style="margin-top: 20px;">
            <div class="text-info" style="margin-bottom: 10px; margin-top: 20px;">
                <span style="font-weight: 600;">Página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
            </div>
            <ul class="pagination" style="margin: 0;">
                @if (Model.HasPrevious)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&laquo;</a></li>
                }

                @if (Model.MaxPageCount > 5)
                {
                    if (Model.Page > 3)
                    {
                        if (Model.MaxPageCount - Model.Page < 3)
                        {
                            for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                        else
                        {
                            for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                    }
                    else
                    {
                        for (var i = 1; i <= 5; i++)
                        {
                            if (i == Model.Page)
                            {
                                <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                            }
                            else
                            {
                                <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                            }
                        }
                    }
                }
                else
                {
                    for (var i = 1; i <= Model.MaxPageCount; i++)
                    {
                        if (i == Model.Page)
                        {
                            <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                        }
                        else
                        {
                            <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                        }
                    }
                }

                @if (Model.HasNext)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&raquo;</a></li>
                }
            </ul>
        </div>
    }
}
else
{
    <div style="border: 1px solid #DDD; border-radius: 4px;">
        <table class="table" style="margin: 0;">
            <thead>
                <tr>
                    <th width="36px;"><span class="fas fa-lock integrity-icon"></span></th>
                    <th>Distinción</th>
                    <th style="width: 184px;">Opciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="6"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                </tr>
            </tbody>
        </table>
    </div>
}