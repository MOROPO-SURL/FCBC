@using MOROPO.FCBC.SGI.Extensions;

@model MOROPO.FCBC.SGI.Models.View.ManagementDashboardViewModel

@{
    ViewData["Title"] = GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer);

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\"></span> " + ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<div id="js-var-scope-layout"
     data-traces-by-day-labels=" @(Newtonsoft.Json.JsonConvert.SerializeObject(Model.UsersList))"
     data-week-statistics-labels="@(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WeekStatisticsColumns))"
     data-traces-by-users="@(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TracesbyUsers))"
     data-Week-traces-statistics-values="@(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WeekTracesStatisticsValues))"></div>

@section styles {
    <style type="text/css">
        .card .mdi {
            font-size: 48px;
        }

        .nav-link .mdi {
            font-size: 18px;
        }
    </style>
}

@section scripts {
    <script src="~/lib/chartjs/chart.min.js"></script>
    <script src="~/js/Views/Dashboard/Index.cshtml.js"></script>
}

<div class="row mb-4">
    <div class="col-md-6">
        <div class="border-bottom mb-2">
            <h5>Usuarios más activos</h5>
        </div>
        <canvas id="tracesByUsersChart"></canvas>
    </div>
    <div class="col-md-6">
        <div class="border-bottom mb-2">
            <h5>Actividad en el sistema</h5>
        </div>
        <canvas id="weekStatisticsChart"></canvas>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="border-bottom mb-2">
            <h5>Universo de creación</h5>
        </div>
        <canvas id="pieChart"></canvas>
    </div>
    <div class="col-md-4">
        <div class="border-bottom mb-2">
            <h5>Distribución de obras</h5>
        </div>
        <canvas id="doughnutChart"></canvas>
    </div>
    <div class="col-md-4">
        <div class="border-bottom mb-2">
            <h5>Manifestaciones punteras</h5>
        </div>
        <canvas id="polarAreaChart"></canvas>
    </div>
</div>
<div class="border-bottom mt-4">
    <h5>Estadísticas primarias</h5>
</div>
<div class="row mb-4 mt-4">
    <div class="col-lg-2 col-md-4">
        <div class="card bg-light">
            <div class="card-body">
                <h5>Usuarios</h5>
                @Model.UserCount
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-md-4">
        <div class="card bg-light">
            <div class="card-body">
                <h5>Registros</h5>
                @Model.TraceCount
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-md-4">
        <div class="card bg-light">
            <div class="card-body">
                <h5>Creadores</h5>
                @Model.CreatorCount
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-md-4">
        <div class="card bg-light">
            <div class="card-body">
                <h5>Grupos de Creación</h5>
                @Model.CreationGroupCount
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-md-4">
        <div class="card bg-light">
            <div class="card-body">
                <h5>Contratistas</h5>
                @Model.ContractorCount
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-md-4">
        <div class="card bg-light">
            <div class="card-body">
                <h5>Obras</h5>
                @Model.WorkCount
            </div>
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-sm-6">
    @for (int i = 0; i < Model.Sections.Count; i += 2)
    {
        var group = Model.Sections.ElementAt(i);

            if (group.Value == null) { continue; }

        <div class="card mb-4">
            <div class="card-header"><h5 style="margin-bottom: 0;">@group.Key</h5></div>
            <div class="card-body">
                @{
                    var total = group.Value.Count;
                    var count = 0;
                }
                @while (count < total)
                {
                    var subList = group.Value.Skip(count).Take(3);

                    <div class="row">
                    @foreach (var item in subList)
                    {
                        <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                            @if (User.HasClaim(claim => claim.Type.Equals(SmartSolucionesCuba.SAPRESSC.Core.Web.Security.ClaimTypes.AccountWithFullAccess) && claim.Value.Equals(true.ToString())) || User.IsInRole(item.Role))
                            {
                                <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                    @item.ToIconographyHtmlString()
                                    <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                </a>
                            }
                            else
                            {
                                <div class="text-muted">
                                    @item.ToIconographyHtmlString()
                                    <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                </div>
                            }
                        </div>
                    }
                    </div>
                    {
                        count += 3;
                    }
                }
            </div>
        </div>
    }
    </div>
    <div class="col-sm-6">
    @if (Model.Sections.Count > 1)
    {
        for (int i = 1; i < Model.Sections.Count; i += 2)
        {
            var group = Model.Sections.ElementAt(i);

                if (group.Value == null) { continue; }

                <div class="card mb-4">
                    <div class="card-header"><h5 style="margin-bottom: 0;">@group.Key</h5></div>
                <div class="card-body">
                    @{
                        var total = group.Value.Count;
                        var count = 0;
                    }
                    @while (count < total)
                    {
                        var subList = group.Value.Skip(count).Take(3);

                        <div class="row">
                            @foreach (var item in subList)
                            {
                                <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                                    @if (User.HasClaim(claim => claim.Type.Equals(SmartSolucionesCuba.SAPRESSC.Core.Web.Security.ClaimTypes.AccountWithFullAccess) && claim.Value.Equals(true.ToString())) || User.IsInRole(item.Role))
                                    {
                                    <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                        @item.ToIconographyHtmlString()
                                        <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                    </a>
                                    }
                                    else
                                    {
                                    <div class="text-muted">
                                        @item.ToIconographyHtmlString()
                                        <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                    </div>
                                    }
                                </div>
                            }
                        </div>
                        {
                            count += 3;
                        }
                    }
                </div>
            </div>
        }
    }
    </div>
</div>