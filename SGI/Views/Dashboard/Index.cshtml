@using MOROPO.FCBC.SGI.Extensions;

@model MOROPO.FCBC.SGI.Models.View.ManagementDashboardViewModel

@{
    ViewData["Title"] = GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer);

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\"></span> " + ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        .card .mdi {
            font-size: 48px;
        }

        .nav-link .mdi {
            font-size: 18px;
        }
    </style>
}

@section scripts {
    <script type="text/javascript" src="~/lib/chartjs/chart.min.js"></script>
    <script type="text/javascript">
        const tracesByDayLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.UsersList));
        const weekStatisticsLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WeekStatisticsColumns));

        const tracesByData = {
            labels: tracesByDayLabels,
            datasets: [{
                label: 'Cantida de registros por usuario',
                data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TracesbyUsers)),
                backgroundColor: [
                    'rgba(255, 99, 132, 0.2)',
                    'rgba(255, 159, 64, 0.2)',
                    'rgba(255, 205, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(54, 162, 235, 0.2)',
                    'rgba(153, 102, 255, 0.2)',
                    'rgba(201, 203, 207, 0.2)'
                ],
                borderColor: [
                    'rgb(255, 99, 132)',
                    'rgb(255, 159, 64)',
                    'rgb(255, 205, 86)',
                    'rgb(75, 192, 192)',
                    'rgb(54, 162, 235)',
                    'rgb(153, 102, 255)',
                    'rgb(201, 203, 207)'
                ],
                borderWidth: 1
            }]
        };

        const tracesByConfig = {
            type: 'bar',
            data: tracesByData,
            options: {}
        };

        const tracesByUsersChart = new Chart(
            document.getElementById('tracesByUsersChart'),
            tracesByConfig
        );

        const weekStatisticsData = {
            labels: weekStatisticsLabels,
            datasets: [{
                label: 'Cantidad de registros por dias',
                data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WeekTracesStatisticsValues)),
                fill: false,
                borderColor: 'rgb(75, 192, 192)',
                backgroundColor: 'rgba(75, 192, 192, 0.5)',
                tension: 0.1
            }]
        };

        const weekStatisticsConfig = {
            type: 'line',
            data: weekStatisticsData,
            options: {}
        };

        const weekStatisticsChart = new Chart(
            document.getElementById('weekStatisticsChart'),
            weekStatisticsConfig
        );
    </script>
}

    <div class="row" style="margin-bottom: 16px;">
        <div class="col-md-6">
            <canvas id="tracesByUsersChart"></canvas>
        </div>
        <div class="col-md-6">
            <canvas id="weekStatisticsChart"></canvas>
        </div>
    </div>

<div class="row">
    <div class="col-sm-6">
    @for (int i = 0; i < Model.Sections.Count; i += 2)
    {
        var group = Model.Sections.ElementAt(i);

        <div class="card mb-3">
            <div class="card-header"><h5 style="margin-bottom: 0;">@group.Key</h5></div>
            <div class="card-body">
                @{
                    var total = group.Value.Count;
                    var count = 0;
                }
                @while (count < total)
                {
                    var subList = group.Value.Skip(count).Take(3);

                    <div class="row">
                    @foreach (var item in subList)
                    {
                        <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                            @if (User.HasClaim(claim => claim.Type.Equals(SmartSolucionesCuba.SAPRESSC.Core.Web.Security.ClaimTypes.AccountWithFullAccess) && claim.Value.Equals(true.ToString())) || User.IsInRole(item.Role))
                            {
                                <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                    @item.ToIconographyHtmlString()
                                    <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                </a>
                            }
                            else
                            {
                                <div class="text-muted">
                                    @item.ToIconographyHtmlString()
                                    <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                </div>
                            }
                        </div>
                    }
                    </div>
                    {
                        count += 3;
                    }
                }
            </div>
        </div>
    }
    </div>
    <div class="col-sm-6">
    @if (Model.Sections.Count > 1)
    {
        for (int i = 1; i < Model.Sections.Count; i += 2)
        {
            var group = Model.Sections.ElementAt(i);

            <div class="card mb-3">
                <div class="card-header"><h5 style="margin-bottom: 0;">@group.Key</h5></div>
                <div class="card-body">
                    @{
                        var total = group.Value.Count;
                        var count = 0;
                    }
                    @while (count < total)
                    {
                        var subList = group.Value.Skip(count).Take(3);

                        <div class="row">
                            @foreach (var item in subList)
                            {
                                <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                                    @if (User.HasClaim(claim => claim.Type.Equals(SmartSolucionesCuba.SAPRESSC.Core.Web.Security.ClaimTypes.AccountWithFullAccess) && claim.Value.Equals(true.ToString())) || User.IsInRole(item.Role))
                                    {
                                    <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                        @item.ToIconographyHtmlString()
                                        <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                    </a>
                                    }
                                    else
                                    {
                                    <div class="text-muted">
                                        @item.ToIconographyHtmlString()
                                        <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                    </div>
                                    }
                                </div>
                            }
                        </div>
                        {
                            count += 3;
                        }
                    }
                </div>
            </div>
        }
    }
    </div>
</div>