@model MOROPO.SAPRESSC.Core.Common.Models.View.SelectionItemInputViewModel<string>

<div>
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Label)
    
    <div class="checkbox">
        <label class="h4">
            @Html.CheckBoxFor(model => model.Selected)
            @GlobalViewLocalizationHelper.Localize(Model.Label.ToString(), ViewLocalizer)
        </label>
    </div>
</div>
