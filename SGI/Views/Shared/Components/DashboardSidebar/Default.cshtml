@using MOROPO.FCBC.SGI.Extensions;

@model Dictionary<string, ICollection<MOROPO.SAPRESSC.Core.Web.Backend.Models.View.ManagementDashboardSectionViewModel>>

<div id="sidebar" class="pb-4" style="margin-top: 56px; padding-top: 28px; position: sticky; height: calc(100vh - 56px); z-index: 1000;  overflow-x: hidden; overflow-y: auto; /* Scrollable contents if viewport is shorter than content. */">
    <nav class="nav flex-column nav-pills nav-sidebar">
        @if (Context.Request.Path.Value == "/management/dashboard")
        {
            <a class="nav-link active" href="#"><span class="mdi mdi-cogs" style="margin-right: 4px;"></span>@GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer)</a>
        }
        else
        {
            <a class="nav-link" href="@Url.Action("index", "dashboard", new { area = string.Empty, key = string.Empty })"><span class="mdi mdi-cogs" style="margin-right: 4px;"></span>@GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer)</a>
        }
    </nav>

    @foreach (var group in Model)
    {
        if (group.Value == null) continue;

        <p class="text-muted" style="margin: 20px 16px 4px 16px; font-weight: bold;">@group.Key</p>
        <hr class="mb-1 mt-0 ml-2 mr-2" />
        <nav class="nav flex-column nav-pills nav-sidebar">
            @foreach (var item in group.Value)
            {
                if (User.HasClaim(claim => claim.Type.Equals(MOROPO.SAPRESSC.Core.Web.Security.Constants.ClaimTypes.AccountWithFullAccess) && claim.Value.Equals(true.ToString())) || User.IsInRole(item.Role))
                {
                    if (Context.Request.Path.Value.StartsWith("/management/" + item.Area + "/" + item.Controller))
                    {
                        <a class="nav-link active" href="@Url.Action(item.Action, item.Controller, new { area = item.Area, sheet = string.Empty })">@item.ToIconographyHtmlString() <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span></a>
                    }
                    else if (string.IsNullOrEmpty(item.Area) && Context.Request.Path.Value.StartsWith("/management/" + item.Controller))
                    {
                        <a class="nav-link active" href="@Url.Action(item.Action, item.Controller, new { area = item.Area, sheet = string.Empty })">@item.ToIconographyHtmlString() <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span></a>
                    }
                    else
                    {
                        <a class="nav-link" href="@Url.Action(item.Action, item.Controller, new { area = item.Area, sheet = string.Empty })">@item.ToIconographyHtmlString() <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span></a>
                    }
                }
                else
                {
                    <a class="nav-link disabled">
                        @item.ToIconographyHtmlString() <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span>
                    </a>
                }
            }
        </nav>
    }
</div>
