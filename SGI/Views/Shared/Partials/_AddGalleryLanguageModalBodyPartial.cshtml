@model MOROPO.FCBC.SGI.Models.View.GalleryLanguagesInputViewModel

<div class="modal-body">
    @Html.HiddenFor(model => model.GalleryId)
    @if (Model.NotSelectedLanguages.Count() > 0)
    {
        <div style="margin-bottom: 20px;">
            @Html.LabelFor(model => model.TranslatableLanguage, new { @class = "control-label" })
            @Html.DropDownListFor(model => model.TranslatableLanguage, Model.NotSelectedLanguages, new { @class = "form-control"})
            @Html.ValidationMessageFor(model => model.TranslatableLanguage, null, new { @class = "text-danger" })
        </div>
    }
    else
    {
        <div>No hay elementos a seleccionar</div>
    }

</div>


