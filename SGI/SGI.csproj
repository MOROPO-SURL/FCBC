    <RootNamespace>MOROPO.FCBC.SGI</RootNamespace>
    <AssemblyName>FCBC-SGI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="dpkeys\**" />
    <Compile Remove="logs\**" />
    <Compile Remove="wwwroot\media\**" />
    <Content Remove="dpkeys\**" />
    <Content Remove="logs\**" />
    <Content Remove="wwwroot\media\**" />
