<Window 
    x:Class="MOROPO.FCBC.Galleries.UWP.Installer.Wind0ws.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Asistente de Instalación para Galería Amalia v0.4.0" MinHeight="480" MinWidth="780" Width="780" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel
            Margin="20"
            HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image
                HorizontalAlignment="Center"
                Margin="10" 
                Source="/Assets/Image/StoreLogo.scale-400.png" Height="200" />
            <TextBlock
                Margin="10,0,10,10"
                Text="versión 0.4.0" TextAlignment="Center" />
            <TextBlock
                Margin="10"
                Text="Herramineta para la instalación de la Galería Amalia, una aplicación de la filial en Camagüey del Fondo Cubano de Bienes Culturales"
                TextWrapping="Wrap"
                FontSize="21"
                TextAlignment="Center" />
            <ProgressBar 
                x:Name="MainProgressBar"
                Margin="10"
                Maximum="100"
                Foreground="#9c4237"
                IsIndeterminate="False" 
                Height="5" />
            <Button
                x:Name="MainActionButton"
                Margin="10"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="20,10,20,14"
                FontSize="21"
                Click="MainActionButton_Click">Comenzar</Button>
        </StackPanel>
    </Grid>
</Window>
