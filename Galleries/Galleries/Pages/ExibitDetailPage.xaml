<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:root="clr-namespace:MOROPO.FCBC.Galleries"
    xmlns:pagemodels="clr-namespace:MOROPO.FCBC.Galleries.Models.Page"
    xmlns:converters="clr-namespace:MOROPO.FCBC.Galleries.Converters"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="MOROPO.FCBC.Galleries.Pages.ExibitDetailPage"
    x:TypeArguments="pagemodels:ExibitDetailPageModel"
    Title="Detalles de Obra Expuesta"
    BackgroundColor="White">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ExibitDetailPageHeightToImageViewerHeightConverter x:Key="ExibitDetailPageHeightToImageViewerHeightConverter" />
            <converters:MediaObjectToViewContentConverter x:Key="MediaObjectToViewContentConverter" />
            <converters:CreatorDisplayApiModelToImageSourceConverter x:Key="CreatorDisplayApiModelToImageSourceConverter" />
            <converters:CriticDisplayApiModelToImageSourceConverter x:Key="CriticDisplayApiModelToImageSourceConverter" />

            <sscxftoolkitpresentationconverters:NullToStringConverter x:Key="TextColorNullToStringConverter" TrueValue="DimGray" FalseValue="Black" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:NotNullOrEmptyStringToBooleanConverter x:Key="NotNullOrEmptyStringToBooleanConverter" />
            <sscxftoolkitpresentationconverters:IfNullOrEmptyToStringConverter x:Key="IfNullOrEmptyToStringConverter" StringReplacement="--" />
            <sscxftoolkitpresentationconverters:IfNullOrEmptyToStringConverter x:Key="CriticAboutIfNullOrEmptyToStringConverter" StringReplacement="No contamos con información acerca de este crítico por el momento" />
            <sscxftoolkitpresentationconverters:IfNullOrEmptyToStringConverter x:Key="CreatorAboutIfNullOrEmptyToStringConverter" StringReplacement="No contamos con información acerca de este creador por el momento" />
            <sscxftoolkitpresentationconverters:EnumerableEmptyToBooleanConverter x:Key="EnumerableEmptyToBooleanConverter" Inverse="True" />
            <sscxftoolkitpresentationconverters:EnumerationToJoinedStringBindingConverter x:Key="CommonEnumerationToJoinedStringBindingConverter" Placeholder="--" Separator=", " />
            <sscxftoolkitpresentationconverters:EnumerationToJoinedStringBindingConverter x:Key="AwardEnumerationToJoinedStringBindingConverter" Placeholder="--" Separator="; " />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="FormCol3BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="475" ChildAbsoluteHorizontalMargin="20" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="FormCol6BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="950" ChildAbsoluteHorizontalMargin="20" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="PersonBindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="180" ChildAbsoluteHorizontalMargin="20" />

            <Style TargetType="Label" x:Key="FieldCaptionLabel">
                <Setter Property="FontFamily" Value="Utopia Bold" />
            </Style>
            <Style TargetType="Label" x:Key="FieldSubCaptionLabel">
                <Setter Property="FontFamily" Value="Utopia Italic" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="DimGray" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <ScrollView Orientation="Vertical">
                <StackLayout Spacing="0">
                    <Grid 
                        BackgroundColor="Black"
                        ColumnSpacing="0" RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            Grid.ColumnSpan="3" Grid.Row="0"
                            Padding="20"
                            HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource ExibitDetailPageHeightToImageViewerHeightConverter}}">
                            <CarouselView 
                                x:Name="MediaItemsCarouselView"
                                ItemsSource="{Binding Path=MediaItems}"
                                IndicatorView="{Reference MediaItemsIndicatorView}">
                                <CarouselView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                                </CarouselView.ItemsLayout>
                                <CarouselView.ItemTemplate>
                                    <DataTemplate>
                                        <ContentView Content="{Binding Path=., Converter={StaticResource MediaObjectToViewContentConverter}}" />
                                    </DataTemplate>
                                </CarouselView.ItemTemplate>
                            </CarouselView>
                        </Grid>
                        <IndicatorView
                            x:Name="MediaItemsIndicatorView"
                            Grid.Column="1" Grid.Row="1"
                            Margin="20"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            HideSingle="True"
                            IndicatorsShape="Square"
                            IndicatorSize="12"
                            IndicatorColor="White"
                            SelectedIndicatorColor="{StaticResource MainContrastTextColor}">
                            
                        </IndicatorView>
                        <Button
                            IsVisible="{Binding Source={Reference MediaItemsIndicatorView}, Path=IsVisible}"
                            Grid.Column="0" Grid.Row="1"
                            VerticalOptions="Center"
                            Padding="0" Margin="8"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Text="&#xF141;"
                            TextColor="White"
                            FontSize="28"
                            FontFamily="Material Design Icons"
                            FontAttributes="Bold"
                            BorderWidth="0"
                            CornerRadius="6"
                            WidthRequest="48" HeightRequest="48"
                            Clicked="PreviuesMediaItemButton_Clicked" />
                        <Button
                            IsVisible="{Binding Source={Reference MediaItemsIndicatorView}, Path=IsVisible}"
                            Grid.Column="2" Grid.Row="1"
                            VerticalOptions="Center"
                            Padding="0" Margin="8"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Text="&#xF142;"
                            TextColor="White"
                            FontSize="28"
                            FontFamily="Material Design Icons"
                            FontAttributes="Bold"
                            BorderWidth="0"
                            CornerRadius="6"
                            WidthRequest="48" HeightRequest="48"
                            Clicked="NextMediaItemButton_Clicked" />
                    </Grid>
                    <StackLayout Spacing="20" Margin="20">
                        <Label 
                            Text="{Binding Path=Work.Title}"
                            Margin="0,10"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource BodyContentSectionHeaderTitleLabelStyle}" />
                        <Label Text="{Binding Path=Work.About}" IsVisible="{Binding Path=Work.About, Converter={StaticResource NotNullOrEmptyStringToBooleanConverter}}" />
                        <BoxView Style="{StaticResource SeparatorBoxViewStyle}" />
                    </StackLayout>
                    <Label Text="{Static root:AppResources.Creators}" Style="{StaticResource FieldCaptionLabel}" Margin="20,0" />
                    <FlexLayout
                        Margin="10"
                        Wrap="Wrap"
                        AlignItems="Start"
                        AlignContent="Start"
                        BindableLayout.ItemsSource="{Binding Path=Work.Creators}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <StackLayout 
                                    Margin="10" 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource PersonBindingLayoutWidthToResponsiveChildWidthConverter}}">
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="CreatorView_Tapped" />
                                    </StackLayout.GestureRecognizers>
                                    <Frame
                                        HorizontalOptions="Center"
                                        Padding="0"
                                        HeightRequest="96" WidthRequest="96"
                                        IsClippedToBounds="True"
                                        CornerRadius="48">
                                        <ffimageloadingforms:CachedImage
                                            Source="{Binding Converter={StaticResource CreatorDisplayApiModelToImageSourceConverter}}"
                                            CacheType="Disk"
                                            CacheDuration="8760:00:00" />
                                    </Frame>
                                    <Label 
                                        FontSize="25"
                                        Text="{Binding Path=Name}"
                                        HorizontalTextAlignment="Center" />
                                    <Label 
                                        Text="{Binding Path=LastName}"
                                        HorizontalTextAlignment="Center" />                                        
                                </StackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <FlexLayout
                        Margin="10"
                        Wrap="Wrap"
                        AlignItems="Start"
                        AlignContent="Start">
                        <StackLayout 
                            Margin="10"
                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol3BindingLayoutWidthToResponsiveChildWidthConverter}}">
                            <Label Text="{Static root:AppResources.Manifestation}" Style="{StaticResource FieldCaptionLabel}" />
                            <Label Text="{Binding Path=Work.Manifestation.Name, StringFormat='Artes Visuales, {0}'}" />
                        </StackLayout>
                        <StackLayout 
                            Margin="10"
                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol3BindingLayoutWidthToResponsiveChildWidthConverter}}">
                            <Label Text="{Static root:AppResources.Year}" Style="{StaticResource FieldCaptionLabel}" />
                            <Label Text="{Binding Path=Work.Year}" />
                        </StackLayout>
                        <StackLayout 
                            Margin="10"
                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol3BindingLayoutWidthToResponsiveChildWidthConverter}}">
                            <Label Text="{Static root:AppResources.Collection}" Style="{StaticResource FieldCaptionLabel}" />
                            <Label Text="{Binding Path=Work.Collection, Converter={StaticResource IfNullOrEmptyToStringConverter}}" />
                        </StackLayout>
                        <StackLayout 
                            Margin="10"
                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol3BindingLayoutWidthToResponsiveChildWidthConverter}}">
                            <Label Text="{Static root:AppResources.Location}" Style="{StaticResource FieldCaptionLabel}" />
                            <Label Text="{Binding Path=Work.Location, Converter={StaticResource IfNullOrEmptyToStringConverter}}" />
                        </StackLayout>
                    </FlexLayout>
                    <FlexLayout
                        Margin="10"
                        Wrap="Wrap"
                        AlignItems="Start"
                        AlignContent="Start">
                        <StackLayout 
                            Margin="10"
                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol6BindingLayoutWidthToResponsiveChildWidthConverter}}">
                            <Label Text="{Static root:AppResources.Techniques}" Style="{StaticResource FieldCaptionLabel}" />
                            <Label Text="{Binding Path=Work.Techniques, Converter={StaticResource CommonEnumerationToJoinedStringBindingConverter}}" />
                        </StackLayout>
                        <StackLayout 
                            Margin="10"
                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol6BindingLayoutWidthToResponsiveChildWidthConverter}}">
                            <Label Text="{Static root:AppResources.Materials}" Style="{StaticResource FieldCaptionLabel}" />
                            <Label Text="{Binding Path=Work.Materials, Converter={StaticResource CommonEnumerationToJoinedStringBindingConverter}}" />
                        </StackLayout>
                        <StackLayout 
                            Margin="10"
                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol6BindingLayoutWidthToResponsiveChildWidthConverter}}">
                            <Label Text="{Static root:AppResources.Themathics}" Style="{StaticResource FieldCaptionLabel}" />
                            <Label Text="{Binding Path=Work.Themathics, Converter={StaticResource CommonEnumerationToJoinedStringBindingConverter}}" />
                        </StackLayout>
                        <StackLayout 
                            Margin="10"
                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol6BindingLayoutWidthToResponsiveChildWidthConverter}}">
                            <Label Text="{Static root:AppResources.Awards}" Style="{StaticResource FieldCaptionLabel}" />
                            <Label Text="{Binding Path=Work.ArtWorkAwards, Converter={StaticResource CommonEnumerationToJoinedStringBindingConverter}}" />
                        </StackLayout>
                    </FlexLayout>
                    <StackLayout
                        IsVisible="{Binding Path=HasDimensions}">
                        <Label Margin="20,0" Text="{Static root:AppResources.Dimensions}" Style="{StaticResource FieldCaptionLabel}" />
                        <BoxView Margin="20,0" Style="{StaticResource SeparatorBoxViewStyle}" />
                        <FlexLayout
                            Margin="10,0,10,10"
                            Wrap="Wrap"
                            AlignItems="Start"
                            AlignContent="Start">
                            <Grid 
                                IsVisible="{Binding Path=Work.Height, Converter={StaticResource NotNullToBooleanConverter}, Mode=OneTime}"
                                Margin="10"
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol3BindingLayoutWidthToResponsiveChildWidthConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Grid.ColumnSpan="2" Grid.Row="0" Text="{Static root:AppResources.Height}" Style="{StaticResource FieldCaptionLabel}" />
                                <Label Grid.Column="0" Grid.Row="1" Text="{Binding Path=Work.Height, Mode=OneTime}" />
                                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Path=Work.DimensionsUnitMeasurement.Symbol, Mode=OneTime}" />
                            </Grid>
                            <Grid 
                                IsVisible="{Binding Path=Work.Width, Converter={StaticResource NotNullToBooleanConverter}, Mode=OneTime}"
                                Margin="10"
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol3BindingLayoutWidthToResponsiveChildWidthConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Grid.ColumnSpan="2" Grid.Row="0" Text="{Static root:AppResources.Width}" Style="{StaticResource FieldCaptionLabel}" />
                                <Label Grid.Column="0" Grid.Row="1" Text="{Binding Path=Work.Width, Mode=OneTime}" />
                                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Path=Work.DimensionsUnitMeasurement.Symbol, Mode=OneTime}" />
                            </Grid>
                            <Grid 
                                IsVisible="{Binding Path=Work.Profundity, Converter={StaticResource NotNullToBooleanConverter}, Mode=OneTime}"
                                Margin="10"
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol3BindingLayoutWidthToResponsiveChildWidthConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Grid.ColumnSpan="2" Grid.Row="0" Text="{Static root:AppResources.Profundity}" Style="{StaticResource FieldCaptionLabel}" />
                                <Label Grid.Column="0" Grid.Row="1" Text="{Binding Path=Work.Profundity, Mode=OneTime}" />
                                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Path=Work.DimensionsUnitMeasurement.Symbol, Mode=OneTime}" />
                            </Grid>
                            <Grid 
                                IsVisible="{Binding Path=Work.Weight, Converter={StaticResource NotNullToBooleanConverter}, Mode=OneTime}"
                                Margin="10"
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FormCol3BindingLayoutWidthToResponsiveChildWidthConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Grid.ColumnSpan="2" Grid.Row="0" Text="{Static root:AppResources.Weight}" Style="{StaticResource FieldCaptionLabel}" />
                                <Label Grid.Column="0" Grid.Row="1" Text="{Binding Path=Work.Weight, Mode=OneTime}" />
                                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Path=Work.WeightUnitMeasurement.Symbol, Mode=OneTime}" />
                            </Grid>
                        </FlexLayout>
                    </StackLayout>
                    <StackLayout 
                        IsVisible="{Binding Path=Work.Valorations, Converter={StaticResource EnumerableEmptyToBooleanConverter}}"
                        Margin="20,0,20,20">
                        <Label Text="{Static root:AppResources.Valorations}" Style="{StaticResource FieldCaptionLabel}" />
                        <BoxView Margin="0,0,0,10" Style="{StaticResource SeparatorBoxViewStyle}" />
                        <StackLayout
                            Spacing="30"
                            BindableLayout.ItemsSource="{Binding Path=Work.Valorations}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Frame
                                            Padding="0"
                                            Grid.Column="0"
                                            VerticalOptions="Center"
                                            HeightRequest="80" WidthRequest="80"                                            
                                            IsClippedToBounds="True"
                                            CornerRadius="40">
                                            <ffimageloadingforms:CachedImage
                                                Source="{Binding Path=Critic, Converter={StaticResource CriticDisplayApiModelToImageSourceConverter}}"
                                                CacheType="Disk"
                                                CacheDuration="8760:00:00" />
                                        </Frame>
                                        <StackLayout
                                            Grid.Column="1" Grid.Row="0"
                                            VerticalOptions="Center">
                                            <Label 
                                                FontSize="25"
                                                Text="{Binding Path=Critic}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="CriticView_Tapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label 
                                                IsVisible="{Binding Path=DeclaredAt, Converter={StaticResource NotNullToBooleanConverter}}"
                                                Text="{Binding Path=DeclaredAt, StringFormat='{0:d/MM/yyyy}'}" />
                                        </StackLayout>                                        
                                        <Label
                                            Grid.ColumnSpan="2" Grid.Row="1"
                                            Text="{Binding Path=Declaration}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                    </StackLayout>                
                </StackLayout>
            </ScrollView>
            <ContentView 
                IsVisible="{Binding Path=., Converter={StaticResource NotNullToBooleanConverter}}"
                BackgroundColor="#A9000000"
                BindingContext="{Binding Path=PresentedCreator}">
                <ScrollView Orientation="Vertical">
                    <Grid>                        
                        <Frame
                            VerticalOptions="Center" HorizontalOptions="Center"
                            Padding="0" Margin="20"
                            WidthRequest="600"
                            BackgroundColor="White">
                            <Grid>                                
                                <StackLayout Margin="20">
                                    <Frame
                                        HorizontalOptions="Center"
                                        Padding="0"
                                        Margin="20,30,20,10"
                                        HeightRequest="240" WidthRequest="240"
                                        IsClippedToBounds="True"
                                        CornerRadius="120">
                                        <ffimageloadingforms:CachedImage
                                            Source="{Binding Path=., Converter={StaticResource CreatorDisplayApiModelToImageSourceConverter}}"
                                            CacheType="Disk"
                                            CacheDuration="8760:00:00" />
                                    </Frame>
                                    <Label 
                                        Text="{Static root:AppResources.Creator}" 
                                        Margin="10,0,10,20"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource BodyContentSectionHeaderTitleLabelStyle}" />
                                    <Label Text="{Static root:AppResources.NameText}" Style="{StaticResource FieldCaptionLabel}" />
                                    <Label 
                                        VerticalOptions="Center"
                                        FontSize="25"
                                        Text="{Binding Path=Name}" />
                                    <Label 
                                        Margin="0,4,0,0"
                                        Text="{Static root:AppResources.LastNameText}" Style="{StaticResource FieldCaptionLabel}" />
                                    <Label 
                                        VerticalOptions="Center"
                                        Text="{Binding Path=LastName}" />
                                    <Label 
                                        Margin="0,4,0,0"
                                        Text="{Static root:AppResources.ArtisticName}" Style="{StaticResource FieldCaptionLabel}" />
                                    <Label 
                                        VerticalOptions="Center"
                                        Text="{Binding Path=Alias, Converter={StaticResource IfNullOrEmptyToStringConverter}}" />
                                    <Label 
                                        Margin="0,4,0,0"
                                        Text="{Static root:AppResources.Manifestations}" Style="{StaticResource FieldCaptionLabel}" />
                                    <Label 
                                        Margin="0,2,0,0"
                                        Text="{Static root:AppResources.VisualArts}" Style="{StaticResource FieldSubCaptionLabel}" />
                                    <Label 
                                        VerticalOptions="Center"
                                        Text="{Binding Path=ArtWorkManifestations, Converter={StaticResource CommonEnumerationToJoinedStringBindingConverter}}" />
                                    <Label 
                                        Margin="0,2,0,0"
                                        Text="{Static root:AppResources.AppliedArts}" Style="{StaticResource FieldSubCaptionLabel}" />
                                    <Label 
                                        VerticalOptions="Center"
                                        Text="{Binding Path=CraftWorkManifestations, Converter={StaticResource CommonEnumerationToJoinedStringBindingConverter}}" />
                                    <Label 
                                        Margin="0,2,0,0"
                                        Text="{Static root:AppResources.Services}" Style="{StaticResource FieldSubCaptionLabel}" />
                                    <Label 
                                        VerticalOptions="Center"
                                        Text="{Binding Path=ServiceManifestations, Converter={StaticResource CommonEnumerationToJoinedStringBindingConverter}}" />
                                    <Label 
                                        Margin="0,4,0,0"
                                        Text="{Static root:AppResources.AboutText}" Style="{StaticResource FieldCaptionLabel}" />
                                    <Label 
                                        Text="{Binding Path=About, Converter={StaticResource CreatorAboutIfNullOrEmptyToStringConverter}}"
                                        TextColor="{Binding Path=About, Converter={StaticResource TextColorNullToStringConverter}}" />
                                </StackLayout>
                                <Button
                                    HorizontalOptions="End" VerticalOptions="Start"
                                    Padding="10"
                                    BackgroundColor="Transparent"
                                    Text="&#xf5ad;"
                                    TextColor="Black"
                                    FontSize="Medium"
                                    FontFamily="Material Design Icons"
                                    BorderWidth="0"
                                    WidthRequest="48" HeightRequest="48"
                                    Clicked="DismissPresentedCreatorButton_Clicked" />
                            </Grid>
                        </Frame>
                    </Grid>
                </ScrollView>
            </ContentView>            
            <ContentView 
                IsVisible="{Binding Path=PresentedCritic, Converter={StaticResource NotNullToBooleanConverter}}"
                BackgroundColor="#A9000000">
                <ScrollView Orientation="Vertical">
                    <Grid>                        
                        <Frame
                            VerticalOptions="Center" HorizontalOptions="Center"
                            Padding="0" Margin="20"
                            WidthRequest="600"
                            BackgroundColor="White">
                            <Grid>                                
                                <StackLayout Margin="20">
                                    <Frame
                                        HorizontalOptions="Center"
                                        Padding="0"
                                        Margin="20,30,20,10"
                                        HeightRequest="240" WidthRequest="240"
                                        IsClippedToBounds="True"
                                        CornerRadius="120">
                                        <ffimageloadingforms:CachedImage
                                            Source="{Binding Path=PresentedCritic, Converter={StaticResource CriticDisplayApiModelToImageSourceConverter}}"
                                            CacheType="Disk"
                                            CacheDuration="8760:00:00" />
                                    </Frame>
                                    <Label 
                                        Text="Crítico" 
                                        Margin="10,0,10,20"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource BodyContentSectionHeaderTitleLabelStyle}" />
                                    <Label Text="Nombre(s)" Style="{StaticResource FieldCaptionLabel}" />
                                    <Label 
                                        VerticalOptions="Center"
                                        FontSize="25"
                                        Text="{Binding Path=PresentedCritic.Name}" />
                                    <Label 
                                        Margin="0,4,0,0"
                                        Text="Apellidos" Style="{StaticResource FieldCaptionLabel}" />
                                    <Label 
                                        VerticalOptions="Center"
                                        Text="{Binding Path=PresentedCritic.LastName}" />
                                    <Label 
                                        Margin="0,4,0,0"
                                        Text="Alias" Style="{StaticResource FieldCaptionLabel}" />
                                    <Label 
                                        VerticalOptions="Center"
                                        Text="{Binding Path=PresentedCritic.Alias, Converter={StaticResource IfNullOrEmptyToStringConverter}}" />
                                    <Label 
                                        Margin="0,4,0,0"
                                        Text="Acerca de" Style="{StaticResource FieldCaptionLabel}" />
                                    <Label 
                                        Text="{Binding Path=PresentedCritic.About, Converter={StaticResource CriticAboutIfNullOrEmptyToStringConverter}}"
                                        TextColor="{Binding Path=PresentedCritic.About, Converter={StaticResource TextColorNullToStringConverter}}" />
                                </StackLayout>
                                <Button
                                    HorizontalOptions="End" VerticalOptions="Start"
                                    Padding="10"
                                    BackgroundColor="Transparent"
                                    Text="&#xf5ad;"
                                    TextColor="Black"
                                    FontSize="Medium"
                                    FontFamily="Material Design Icons"
                                    BorderWidth="0"
                                    WidthRequest="48" HeightRequest="48"
                                    Clicked="DismissPresentedCriticButton_Clicked" />
                            </Grid>
                        </Frame>
                    </Grid>
                </ScrollView>
            </ContentView>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>