<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:MOROPO.FCBC.Galleries.Models.Page"
    xmlns:views="clr-namespace:MOROPO.FCBC.Galleries.Views"
    xmlns:converters="clr-namespace:MOROPO.FCBC.Galleries.Converters"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:ffimageloadingtransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
    x:Class="MOROPO.FCBC.Galleries.Pages.ExposureDetailPage"
    x:TypeArguments="pagemodels:ExposureDetailPageModel"
    Title="Exposición"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:EmployeeDisplayApiModelToImageSourceConverter x:Key="EmployeeDisplayApiModelToImageSourceConverter" />

            <sscxftoolkitpresentationconverters:NullToStringConverter x:Key="TextColorNullToStringConverter" TrueValue="DimGray" FalseValue="Black" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:IfNullOrEmptyToStringConverter x:Key="IfNullOrEmptyToStringConverter" StringReplacement="--" />
            <sscxftoolkitpresentationconverters:IfNullOrEmptyToStringConverter x:Key="EmployeecAboutIfNullOrEmptyToStringConverter" StringReplacement="No contamos con información acerca de este trabjador por el momento" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="180" ChildAbsoluteHorizontalMargin="20" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="ButtonsBindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="200" ChildAbsoluteHorizontalMargin="20" />

            <Style TargetType="Label" x:Key="FieldCaptionLabel">
                <Setter Property="FontFamily" Value="Utopia Bold" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="1" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                Padding="10,40,10,10"
                BackgroundColor="{StaticResource PrimaryColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Text="Exposición"
                    TextColor="White"
                    HorizontalTextAlignment="Center" />
                <Button
                    Grid.Column="0"
                    HorizontalOptions="Start" VerticalOptions="Center"
                    BackgroundColor="#78251A"
                    Text="&#xFB0D;"
                    TextColor="White"
                    FontFamily="Material Design Icons"
                    Clicked="BackButton_Clicked" />
            </Grid>
            <BoxView Grid.Row="1" Color="#78251A" />
            <ScrollView Grid.Row="2" Orientation="Vertical">
                <StackLayout Style="{StaticResource BodyContentStackLayoutStyle}">
                    <Grid>
                        <ffimageloadingforms:CachedImage
                            HeightRequest="{Binding Source={Reference HeaderContentContainer}, Path=Height}"
                            Aspect="AspectFill"
                            Source="{Binding Path=GalleyFeatureImageSource}"
                            CacheType="Disk"
                            CacheDuration="8760:00:00" />
                        <BoxView Color="#dd512c10" />
                        <StackLayout
                            x:Name="HeaderContentContainer"
                            HorizontalOptions="Center"
                            Spacing="0"
                            WidthRequest="{StaticResource HeaderRequestWidth}" 
                            Margin="10,60">
                            <Label
                                Style="{StaticResource HeaderTitleLabelStyle}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Sala Expositiva"
                                HorizontalTextAlignment="Center"
                                Margin="0,18,0,0"
                                Style="{StaticResource HeaderSubTitleCaptionLabelStyle}" />
                            <Label
                                Text="{Binding Path=Exposure.Name}"
                                Margin="0,0,0,18"
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource HeaderSubTitleLabelStyle}" />
                            <Button
                                Margin="0,15,0,0"
                                Style="{StaticResource HeaderButtonStyle}"
                                Text="Entrar a la Sala"
                                Clicked="GoToExposureButton_Clicked" />
                        </StackLayout>
                    </Grid>
                    <Label
                        Margin="20,20,20,0"
                        Text="{Binding Path=Exposure.Description}" />
                    <StackLayout Style="{StaticResource BodyContentSectionHeaderStackLayoutStyle}">
                        <Label Style="{StaticResource BodyContentSectionHeaderTitleLabelStyle}" Text="Curadores" />
                        <BoxView Style="{StaticResource BodyContentSectionHeaderSeparatorBoxViewStyle}" />                        
                    </StackLayout>
                    <FlexLayout
                        Margin="10"
                        Wrap="Wrap"
                        AlignItems="Start" AlignContent="Start"
                        BindableLayout.ItemsSource="{Binding Path=Exposure.Curators}">
                        <BindableLayout.EmptyView>
                            <Label
                                Margin="10"
                                Text="No se han especificado curadores"
                                HorizontalTextAlignment="Center"
                                TextColor="DimGray" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Margin="10" Padding="0"
                                    WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}">
                                    <StackLayout Margin="0,8" Spacing="0">
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="EmployeeView_Tapped" />
                                        </StackLayout.GestureRecognizers>
                                        <ffimageloadingforms:CachedImage
                                            Grid.Column="0"
                                            HorizontalOptions="Center"
                                            HeightRequest="108" WidthRequest="108"
                                            Source="{Binding Converter={StaticResource EmployeeDisplayApiModelToImageSourceConverter}}"
                                            CacheType="Disk"
                                            CacheDuration="8760:00:00">
                                            <ffimageloadingforms:CachedImage.Transformations>
                                                <ffimageloadingtransformations:CircleTransformation BorderSize="3" BorderHexColor="#FFFAFA" />
                                            </ffimageloadingforms:CachedImage.Transformations>
                                        </ffimageloadingforms:CachedImage>
                                        <Label 
                                            Text="{Binding Path=Name}"
                                            HorizontalTextAlignment="Center"
                                            FontSize="{StaticResource PersonFirstNameLabelFontSize}" />
                                        <Label
                                            VerticalOptions="StartAndExpand"
                                            Text="{Binding Path=LastName}"
                                            HorizontalTextAlignment="Center" />
                                    </StackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </StackLayout>
            </ScrollView>
            <ContentView
                Grid.RowSpan="3"
                IsVisible="{Binding Path=PresentedEmployee, Converter={StaticResource NotNullToBooleanConverter}}"
                BackgroundColor="#A9000000">
                <ScrollView Orientation="Vertical">
                    <Grid>
                        <Frame
                            VerticalOptions="Center" HorizontalOptions="Center"
                            Padding="0" Margin="20"
                            WidthRequest="600"
                            BackgroundColor="White">
                            <Grid>
                                <StackLayout Spacing="0">
                                    <StackLayout Margin="20,20,20,0">
                                        <ffimageloadingforms:CachedImage
                                            Grid.Column="0"
                                            HorizontalOptions="Center"
                                            Margin="20,30,20,10"
                                            HeightRequest="240" WidthRequest="240"
                                            Source="{Binding Path=PresentedEmployee, Converter={StaticResource EmployeeDisplayApiModelToImageSourceConverter}}"
                                            CacheType="Disk"
                                            CacheDuration="8760:00:00">
                                            <ffimageloadingforms:CachedImage.Transformations>
                                                <ffimageloadingtransformations:CircleTransformation BorderSize="3" BorderHexColor="#FFFAFA" />
                                            </ffimageloadingforms:CachedImage.Transformations>
                                        </ffimageloadingforms:CachedImage>
                                        <Label 
                                            Text="Trabajador" 
                                            Margin="10,0,10,20"
                                            HorizontalTextAlignment="Center"
                                            Style="{StaticResource BodyContentSectionHeaderTitleLabelStyle}" />
                                        <Label Text="Nombre(s)" Style="{StaticResource FieldCaptionLabel}" />
                                        <Label 
                                            VerticalOptions="Center"
                                            FontSize="25"
                                            Text="{Binding Path=PresentedEmployee.Name}" />
                                        <Label 
                                            Margin="0,4,0,0"
                                            Text="Apellidos" Style="{StaticResource FieldCaptionLabel}" />
                                        <Label 
                                            VerticalOptions="Center"
                                            Text="{Binding Path=PresentedEmployee.LastName, Converter={StaticResource IfNullOrEmptyToStringConverter}}" />
                                        <Label 
                                            Margin="0,4,0,0"
                                            Text="Acerca de" Style="{StaticResource FieldCaptionLabel}" />
                                        <Label 
                                            Text="{Binding Path=PresentedEmployee.About, Converter={StaticResource EmployeecAboutIfNullOrEmptyToStringConverter}}"
                                            TextColor="{Binding Path=PresentedEmployee.About, Converter={StaticResource TextColorNullToStringConverter}}" />
                                        <Label 
                                            Margin="0,4,0,0"
                                            Text="Contactar" Style="{StaticResource FieldCaptionLabel}" />
                                        <BoxView Style="{StaticResource SeparatorBoxViewStyle}" />
                                    </StackLayout>
                                    <FlexLayout
                                        Margin="10"
                                        Wrap="Wrap"
                                        AlignItems="Start" AlignContent="Start">
                                        <Button 
                                            WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource ButtonsBindingLayoutWidthToResponsiveChildWidthConverter}}"
                                            Margin="10"
                                            Text="Correo Electrónico"
                                            Clicked="EmployeeEmailContactButton_Clicked" />
                                        <Button 
                                            WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource ButtonsBindingLayoutWidthToResponsiveChildWidthConverter}}"
                                            Margin="10"
                                            Text="Llamada Telefónica"
                                            Clicked="EmployeePhoneContactButton_Clicked" />
                                    </FlexLayout>
                                </StackLayout>
                                <Button
                                    HorizontalOptions="End" VerticalOptions="Start"
                                    Padding="10"
                                    BackgroundColor="Transparent"
                                    Text="&#xf5ad;"
                                    TextColor="Black"
                                    FontSize="Medium"
                                    FontFamily="Material Design Icons"
                                    BorderWidth="0"
                                    WidthRequest="48" HeightRequest="48"
                                    Clicked="DismissPresentedEmployeeButton_Clicked" />
                            </Grid>
                        </Frame>
                    </Grid>
                </ScrollView>
            </ContentView>
            <views:BusyView Grid.RowSpan="3" />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>