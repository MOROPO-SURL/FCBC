<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:MOROPO.FCBC.Galleries.Models.Page"
    xmlns:views="clr-namespace:MOROPO.FCBC.Galleries.Views"
    xmlns:root="clr-namespace:MOROPO.FCBC.Galleries"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="MOROPO.FCBC.Galleries.Pages.MainPage"
    x:TypeArguments="pagemodels:MainPageModel"
    Title="{Static root:AppResources.PageTitleHome}"
    BackgroundColor="White">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="400" ChildAbsoluteHorizontalMargin="20" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="{Static root:AppResources.UpdateText}"
            Order="Primary"
            Clicked="RefreshToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Material Design Icons" Glyph="&#xF450;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="{Static root:AppResources.LanguageText}"
            Order="Primary"
            Clicked="LanguageToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Material Design Icons" Glyph="&#xF1E7;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <ScrollView Orientation="Vertical">
                <StackLayout Style="{StaticResource BodyContentStackLayoutStyle}">
                    <Grid>
                        <ffimageloadingforms:CachedImage
                            HeightRequest="{Binding Source={Reference HeaderContentContainer}, Path=Height}"
                            Aspect="AspectFill"
                            Source="{Binding Path=ImageSource}"
                            CacheType="Disk"
                            CacheDuration="8760:00:00" />
                        <BoxView Color="#dd512c10" />
                        <StackLayout
                            x:Name="HeaderContentContainer"
                            HorizontalOptions="Center" 
                            WidthRequest="{StaticResource HeaderRequestWidth}" 
                            Margin="10,30">
                            <Label
                                Style="{StaticResource HeaderTitleLabelStyle}"
                                Text="{Static root:AppResources.AppTitle}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Margin="0,18"
                                Text="{Binding Path=About, TargetNullValue='Et lorem dolor placerat at sed zzril sed lorem gubergren at euismod elitr invidunt dolore dolor aliquyam at diam sanctus'}"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource MainContrastTextColor}" />
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Padding="0"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Grid.Column="0"
                                    Text="{Static root:AppResources.HistoryText}"
                                    Clicked="HistoryHeaderButton_Clicked" />
                                <Button
                                    Padding="0"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Grid.Column="1"
                                    Text="{Static root:AppResources.CatalogText}" />
                                <Button
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Grid.Column="2"
                                    Text="{Static root:AppResources.ContactText}"
                                    Clicked="ContactHeaderButton_Clicked" />
                            </Grid>
                        </StackLayout>
                    </Grid>
                    <StackLayout Style="{StaticResource BodyContentSectionHeaderStackLayoutStyle}">
                        <Label 
                            Text="{Static root:AppResources.ExposureRoomsHeader}"
                            Style="{StaticResource BodyContentSectionHeaderTitleLabelStyle}" />
                        <BoxView Style="{StaticResource BodyContentSectionHeaderSeparatorBoxViewStyle}" />                        
                    </StackLayout>
                    <FlexLayout
                        Margin="10"
                        Wrap="Wrap"
                        AlignItems="Start" AlignContent="Start"
                        BindableLayout.ItemsSource="{Binding Path=Exposures}">
                        <BindableLayout.EmptyView>
                            <Label
                                Margin="10"
                                Text="{Static root:AppResources.EmptyExposureRoomText}"
                                HorizontalTextAlignment="Center"
                                TextColor="DimGray" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    Margin="10" Padding="0"
                                    BackgroundColor="WhiteSmoke"
                                    HasShadow="true"
                                    WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}"
                                    HeightRequest="260">
                                    <StackLayout Margin="20,15" Spacing="10">
                                        <Label 
                                            Text="{Binding Path=Name}"
                                            FontSize="32"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            VerticalOptions="StartAndExpand"
                                            Text="{Binding Path=Description}"
                                            TextColor="DimGray"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="4" />
                                        <Button
                                            Text="{Static root:AppResources.DetailsText}"
                                            Clicked="ExposureDetailButton_Clicked" />
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </StackLayout>
            </ScrollView>
            <views:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>