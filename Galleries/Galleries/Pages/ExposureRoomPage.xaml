<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:MOROPO.FCBC.Galleries.Models.Page"
    xmlns:views="clr-namespace:MOROPO.FCBC.Galleries.Views"
    xmlns:converters="clr-namespace:MOROPO.FCBC.Galleries.Converters"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:icplugin="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    xmlns:urho="clr-namespace:Urho.Forms;assembly=UrhoSharp.Forms"
    x:Class="MOROPO.FCBC.Galleries.Pages.ExposureRoomPage"
    x:TypeArguments="pagemodels:ExposureRoomPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CreatorDisplayApiModelToImageSourceConverter x:Key="CreatorDisplayApiModelToImageSourceConverter" />

            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:NotNullOrEmptyStringToBooleanConverter x:Key="NotNullOrEmptyStringToBooleanConverter" />
            <sscxftoolkitpresentationconverters:EnumerationToJoinedStringBindingConverter x:Key="EnumerationToJoinedStringBindingConverter" Placeholder="No se defnieron tecnícas para esta obra" Separator=", " />

            <Style TargetType="Label" ApplyToDerivedTypes="True">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="21" />
            </Style>
            
            <Style TargetType="Label" x:Key="FieldCaptionLabel">
                <Setter Property="TextColor" Value="LightGray" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontFamily" Value="Utopia Bold" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <urho:UrhoSurface x:Name="MainUrhoSurface" VerticalOptions="FillAndExpand" />
            <Frame
                VerticalOptions="Center" HorizontalOptions="Center"
                Padding="0" Margin="20"
                WidthRequest="400"
                IsVisible="{Binding Path=TargetArtWork, Converter={StaticResource NotNullToBooleanConverter}}"
                BackgroundColor="#f83d3d3d">
                <Grid>
                    <StackLayout Margin="20" Spacing="0">
                        <Label Text="Título" Style="{StaticResource FieldCaptionLabel}" Margin="0,4,0,0" />
                        <Label 
                            Text="{Binding Path=TargetArtWork.Title}"
                            FontSize="28" />
                        <Label Text="Creador(es)" Style="{StaticResource FieldCaptionLabel}" Margin="0,8,0,0" />
                        <StackLayout
                            BindableLayout.ItemsSource="{Binding Path=TargetArtWork.Creators}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Margin="4"
                                    Text="No hay creadores especificados en este momento"
                                    TextColor="DimGray" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <icplugin:CircleImage
                                            Grid.Column="0"
                                            VerticalOptions="Center"
                                            HeightRequest="80" WidthRequest="80"
                                            Source="{Binding Converter={StaticResource CreatorDisplayApiModelToImageSourceConverter}}"
                                            BorderThickness="2"
                                            BorderColor="Snow" />
                                        <StackLayout 
                                            Grid.Column="1"
                                            Spacing="0"
                                            VerticalOptions="Center">                                        
                                            <Label 
                                                Grid.Column="1" Grid.Row="0"
                                                VerticalOptions="Center"
                                                FontSize="25"
                                                Text="{Binding Path=Name}" />
                                            <Label 
                                                Grid.Column="1" Grid.Row="1"
                                                VerticalOptions="Center"
                                                Text="{Binding Path=LastName}" />
                                        </StackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                        <Label Text="Técnica(s)" Style="{StaticResource FieldCaptionLabel}" Margin="0,8,0,0" />
                        <Label 
                            Text="{Binding Path=TargetArtWork.Techniques, Converter={StaticResource EnumerationToJoinedStringBindingConverter}}" />
                        <Label Text="Año" Style="{StaticResource FieldCaptionLabel}" Margin="0,8,0,0" />
                        <Label 
                            Margin="0,0,0,12"
                            Text="{Binding Path=TargetArtWork.Year}" />
                        <Label 
                            IsVisible="{Binding Path=TargetArtWork.About, Converter={StaticResource NotNullOrEmptyStringToBooleanConverter}}"
                            Margin="0,0,0,12"
                            Text="{Binding Path=TargetArtWork.About}"
                            LineBreakMode="TailTruncation"
                            MaxLines="3" />
                        <Button 
                            HorizontalOptions="Center" 
                            Style="{StaticResource AccentButtonStyle}"
                            Text="Detalles"
                            Clicked="ExibitDetailButton_Clicked" />
                    </StackLayout>
                    <Button
                        HorizontalOptions="End" VerticalOptions="Start"
                        Padding="10"
                        BackgroundColor="Transparent"
                        Text="&#xf5ad;"
                        TextColor="GhostWhite"
                        FontSize="Medium"
                        FontFamily="Material Design Icons"
                        BorderWidth="0"
                        WidthRequest="48" HeightRequest="48"
                        Clicked="CloseButton_Clicked" />
                </Grid>
            </Frame>
                
            <views:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>