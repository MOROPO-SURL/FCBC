<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <RootNamespace>MOROPO.FCBC.Galleries</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Materials\Stone.xml" />
    <None Remove="Assets\Models\Door.fbx" />
    <None Remove="Assets\Textures\DarkGrungeWall.jpg" />
    <None Remove="Assets\Textures\Identity_Primary_FCBC.jpg" />
    <None Remove="Assets\Textures\ListoneWoodFloor.jpg" />
    <None Remove="Assets\Textures\PlayboWood.jpg" />
    <None Remove="Assets\Textures\Roof.jpg" />
    <None Remove="Assets\Textures\Wall.jpg" />
    <None Remove="Assets\Textures\WhiteWallGrungePlaster.jpg" />
    <None Remove="Assets\Textures\WhiteWallUneven.jpg" />
    <None Remove="Assets\Textures\Wood_Floor_007_COLOR.jpg" />
    <None Remove="Assets\Textures\Wood_Floor_007_NORM.jpg" />
    <None Remove="Assets\Textures\Wood_Floor_007_ROUGH.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Materials\Stone.xml" />
    <Content Include="Assets\Models\Door.fbx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\Identity_Primary_FCBC.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\PlayboWood.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\Roof.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\Wall.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\Wood_Floor_007_COLOR.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\Wood_Floor_007_NORM.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\Wood_Floor_007_ROUGH.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UrhoSharp.Forms" Version="1.9.67" />
    <PackageReference Include="Xamarin.FFImageLoading.Forms" Version="2.4.11.982" />
    <PackageReference Include="Xamarin.Forms" Version="5.0.0.2515" />
    <PackageReference Include="Xamarin.Essentials" Version="1.7.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Pages\VirtualGalleryRoomPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Engine3D\" />
    <Folder Include="Models\View\" />
  </ItemGroup>
</Project>