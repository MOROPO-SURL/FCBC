<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <RootNamespace>MOROPO.FCBC.Galleries</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Font\IconmonstrIconic.ttf" />
    <None Remove="Assets\Font\materialdesignicons-webfont.ttf" />
    <None Remove="Assets\Font\Rotis-Semi-Sans-Std-46-Light-Italic.otf" />
    <None Remove="Assets\Font\Rotis-Semi-Sans-Std-55-Regular.otf" />
    <None Remove="Assets\Font\Rotis-Semi-Sans-Std-56-Italic.otf" />
    <None Remove="Assets\Font\Rotis-Semi-Sans-Std-65-Bold.otf" />
    <None Remove="Assets\Font\Rotis-Semi-Sans-Std-75-Extra-Bold.otf" />
    <None Remove="Assets\Font\Utopia-Bold.otf" />
    <None Remove="Assets\Font\Utopia-BoldItalic.otf" />
    <None Remove="Assets\Font\Utopia-Italic.otf" />
    <None Remove="Assets\Font\Utopia-Regular.otf" />
    <None Remove="Assets\Image\DefaultGalleyBanner.jpg" />
    <None Remove="Assets\Image\Identity_Primary_FCBC.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Font\IconmonstrIconic.ttf" />
    <EmbeddedResource Include="Assets\Font\materialdesignicons-webfont.ttf" />
    <EmbeddedResource Include="Assets\Font\Rotis-Semi-Sans-Std-55-Regular.otf" />
    <EmbeddedResource Include="Assets\Font\Rotis-Semi-Sans-Std-46-Light-Italic.otf" />
    <EmbeddedResource Include="Assets\Font\Rotis-Semi-Sans-Std-56-Italic.otf" />
    <EmbeddedResource Include="Assets\Font\Rotis-Semi-Sans-Std-65-Bold.otf" />
    <EmbeddedResource Include="Assets\Font\Rotis-Semi-Sans-Std-75-Extra-Bold.otf" />
    <EmbeddedResource Include="Assets\Font\Utopia-Bold.otf" />
    <EmbeddedResource Include="Assets\Font\Utopia-BoldItalic.otf" />
    <EmbeddedResource Include="Assets\Font\Utopia-Italic.otf" />
    <EmbeddedResource Include="Assets\Font\Utopia-Regular.otf" />
    <EmbeddedResource Include="Assets\Image\DefaultGalleyBanner.jpg" />
    <EmbeddedResource Include="Assets\Image\Identity_Primary_FCBC.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.Forms" Version="2.88.3" />
    <PackageReference Include="SSCXFToolKit.Mvvm" Version="0.4.10-alpha" />
    <PackageReference Include="SSCXFToolKit.Presentation" Version="0.6.3" />
    <PackageReference Include="UrhoSharp.Forms" Version="1.9.67" />
    <PackageReference Include="Xam.Plugins.Forms.ImageCircle" Version="3.0.0.5" />
    <PackageReference Include="Xamarin.CommunityToolkit" Version="2.0.6" />
    <PackageReference Include="Xamarin.FFImageLoading.Forms" Version="2.4.11.982" />
    <PackageReference Include="Xamarin.Forms" Version="5.0.0.2578" />
    <PackageReference Include="Xamarin.Essentials" Version="1.7.6" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="AppResources.pt.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="AppResources.ru.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="AppResources.fr.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="AppResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AppResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Pages\ContactPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Pages\ExibitDetailPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Pages\ExposureDetailPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Pages\ExposureRoomPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Pages\HistoryPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Pages\RequiredUpdatePage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\BusyView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\ExibitImageView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\ExibitVideoView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SGI.API.Connect\SGI.API.Connect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="AppResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AppResources.resx</DependentUpon>
    </Compile>
    <Compile Update="Pages\ExposureDetailPage.xaml.cs">
      <DependentUpon>ExposureDetailPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Pages\ExposureRoomPage.xaml.cs">
      <DependentUpon>ExposureRoomPage.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>