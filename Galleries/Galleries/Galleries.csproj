<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <RootNamespace>MOROPO.FCBC.Galleries</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Materials\Stone.xml" />
    <None Remove="Assets\Models\Box.mdl" />
    <None Remove="Assets\Textures\DarkGrungeWall.jpg" />
    <None Remove="Assets\Textures\ListoneWoodFloor.jpg" />
    <None Remove="Assets\Textures\PlayboWood.jpg" />
    <None Remove="Assets\Textures\WhiteWallGrungePlaster.jpg" />
    <None Remove="Assets\Textures\WhiteWallUneven.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Materials\Stone.xml" />
    <Content Include="Assets\Models\Box.mdl" />
    <Content Include="Assets\Textures\DarkGrungeWall.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\ListoneWoodFloor.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\PlayboWood.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\WhiteWallGrungePlaster.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\WhiteWallUneven.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UrhoSharp.Forms" Version="1.9.67" />
    <PackageReference Include="Xamarin.Forms" Version="5.0.0.2515" />
    <PackageReference Include="Xamarin.Essentials" Version="1.7.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Pages\VirtualGalleryRoomPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
  </ItemGroup>
</Project>