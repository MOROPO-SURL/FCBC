<?xml version="1.0" encoding="utf-8" ?>
<Application 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MOROPO.FCBC.Galleries.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#9c4237</Color>
            <Color x:Key="MainContrastTextColor">#cbab71</Color>

            <x:Double x:Key="HeaderRequestWidth">360</x:Double>
            <x:Double x:Key="BodyContentSectionHeaderTitleLabelFontSize">32</x:Double>
            <x:Double x:Key="PersonFirstNameLabelFontSize">27</x:Double>

            <OnPlatform x:TypeArguments="x:Double" Default="21" Android="16" WinPhone="21"  x:Key="ButtonFontSize" />

            <Style TargetType="Label" ApplyToDerivedTypes="True">
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontFamily" Value="Rotis SemiSans Std Regular" />
            </Style>

            <Style TargetType="Button" ApplyToDerivedTypes="True">
                <Setter Property="FontSize" Value="{StaticResource ButtonFontSize}" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="FontFamily" Value="Utopia Regular" />
            </Style>

            <Style TargetType="BoxView" x:Key="SeparatorBoxViewStyle">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="Black" />
            </Style>

            <Style TargetType="Label" x:Key="HeaderTitleLabelStyle">
                <Setter Property="Text" Value="Galería Amalia" />
                <Setter Property="TextColor" Value="{StaticResource MainContrastTextColor}" />
                <Setter Property="FontSize" Value="52" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontFamily" Value="Utopia Bold" />
            </Style>

            <Style TargetType="Label" x:Key="HeaderSubTitleLabelStyle">
                <Setter Property="TextColor" Value="{StaticResource MainContrastTextColor}" />
                <Setter Property="FontSize" Value="36" />
                <Setter Property="FontFamily" Value="Utopia Regular" />
            </Style>

            <Style TargetType="Label" x:Key="HeaderSubTitleCaptionLabelStyle">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="28" />
            </Style>

            <Style TargetType="Button" x:Key="AccentButtonStyle">
                <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="BackgroundColor" Value="{StaticResource MainContrastTextColor}" />
                <Setter Property="FontSize" Value="{StaticResource ButtonFontSize}" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="FontFamily" Value="Utopia Regular" />
            </Style>

            <Style TargetType="Button" x:Key="HeaderButtonStyle" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="HeightRequest" Value="56" />
            </Style>

            <Style TargetType="StackLayout" x:Key="BodyContentStackLayoutStyle">
                <Setter Property="Spacing" Value="0" />
            </Style>

            <Style TargetType="StackLayout" x:Key="BodyContentSectionHeaderStackLayoutStyle">
                <Setter Property="Margin" Value="10,10,10,0" />
                <Setter Property="Spacing" Value="0" />
            </Style>

            <Style TargetType="Label" x:Key="BodyContentSectionHeaderTitleLabelStyle">
                <Setter Property="Margin" Value="10,10,10,8" />
                <Setter Property="FontSize" Value="{StaticResource BodyContentSectionHeaderTitleLabelFontSize}" />
                <Setter Property="FontFamily" Value="Utopia Bold" />
            </Style>

            <Style TargetType="BoxView" x:Key="BodyContentSectionHeaderSeparatorBoxViewStyle" BasedOn="{StaticResource SeparatorBoxViewStyle}">
                <Setter Property="Margin" Value="10,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>